@{
    ViewBag.Title = "Thêm Khung Giờ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header mb-4">
    <h1 class="page-title">Thêm Khung Giờ Chiếu</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin/QuanLyKhungGio">Khung Giờ</a></li>
            <li class="breadcrumb-item active">Thêm mới</li>
        </ol>
    </nav>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]</div>
}

<div class="card" style="max-width: 500px;">
    <div class="card-body p-4">
        <form action="/Admin/ThemKhungGio" method="post">
            <div class="mb-4">
                <label class="form-label">Giờ Bắt Đầu <span class="text-danger">*</span></label>
                <input type="time" name="gioBatDau" class="form-control admin-input" required />
                <div class="form-text text-white">Thời điểm bắt đầu suất chiếu</div>
            </div>
            <div class="mb-4">
                <label class="form-label">Giờ Kết Thúc <span class="text-danger">*</span></label>
                <input type="time" name="gioKetThuc" class="admin-input form-control" required />
                <div class="form-text text-white">Thời điểm kết thúc suất chiếu</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i> Thêm Khung Giờ
                </button>
                <a href="/Admin/QuanLyKhungGio" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

<style>
    .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); }
    .page-title { font-family: var(--font-display); font-size: 28px; margin: 0 0 8px; }
    .admin-input { background: rgba(255,255,255,.05); border: 1px solid var(--border); color: #fff; padding: 10px 14px; border-radius: 8px; }
    .admin-input:focus { background: rgba(255,255,255,.08); border-color: var(--accent); outline: none; color: #fff; }
    .form-label { color: var(--text-sec); font-size: 14px; margin-bottom: 8px; }
    .breadcrumb-item a { color: var(--accent); }
    .breadcrumb-item.active { color: var(--text-muted); }
    .breadcrumb-item + .breadcrumb-item::before { color: var(--text-muted); }
</style>
