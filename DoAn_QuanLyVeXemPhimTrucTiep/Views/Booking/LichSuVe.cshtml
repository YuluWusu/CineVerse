@model List<DoAn_QuanLyVeXemPhimTrucTiep.Models.VE>
@{
    ViewBag.Title = "Lịch sử đặt vé";
    Layout = "~/Views/Shared/_Khung.cshtml";
}

@section Styles {
    <style>
        .history-container {
            padding: 80px 0;
            background: var(--bg-void);
            min-height: 80vh;
        }

        .history-title {
            font-family: var(--font-display);
            font-size: 32px;
            color: var(--text-primary);
            text-align: center;
            margin-bottom: 40px;
            letter-spacing: 1px;
        }

        .history-title span {
            color: var(--accent);
        }

        .ticket-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
            max-width: 800px;
            margin: 0 auto;
        }

        .ticket-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            transition: all 0.2s;
        }

        .ticket-card:hover {
            border-color: rgba(232, 184, 75, 0.4);
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .ticket-poster {
            width: 140px;
            flex-shrink: 0;
        }

        .ticket-poster img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .ticket-info {
            padding: 20px;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .ticket-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 10px;
        }

        .movie-title {
            font-size: 20px;
            font-weight: 700;
            color: #fff;
            margin: 0;
        }

        .ticket-status {
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 20px;
            font-weight: bold;
            background: rgba(75, 232, 124, 0.15);
            color: #4be87c;
            border: 1px solid rgba(75, 232, 124, 0.3);
            white-space: nowrap;
        }

        .ticket-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 15px;
        }

        .detail-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: var(--text-muted);
        }

        .detail-item i {
            color: var(--accent);
            font-size: 16px;
        }

        .ticket-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 15px;
            border-top: 1px dashed rgba(255,255,255,0.1);
        }

        .booking-date {
            font-size: 12px;
            color: rgba(255,255,255,0.4);
        }

        .ticket-price {
            font-size: 18px;
            font-family: var(--font-display);
            color: var(--accent);
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: var(--bg-card);
            border-radius: 12px;
            border: 1px dashed var(--border);
            max-width: 600px;
            margin: 0 auto;
        }

        .empty-state i {
            font-size: 60px;
            color: var(--text-muted);
            margin-bottom: 20px;
            display: block;
        }

        .empty-state p {
            color: var(--text-muted);
            margin-bottom: 25px;
        }

        .btn-book {
            background: var(--accent);
            color: #000;
            padding: 10px 25px;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
            display: inline-block;
            transition: all 0.2s;
        }

        .btn-book:hover {
            background: var(--accent-dim);
            transform: translateY(-2px);
        }

        @@media (max-width: 768px) {
            .ticket-card {
                flex-direction: column;
            }
            .ticket-poster {
                width: 100%;
                height: 200px;
            }
            .ticket-details {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="history-container">
    <div class="container">
        <h1 class="history-title">LỊCH SỬ <span>ĐẶT VÉ</span></h1>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-ticket-perforated"></i>
                <h3>Chưa có giao dịch nào</h3>
                <p>Bạn chưa đặt vé nào trên hệ thống. Hãy chọn cho mình một bộ phim hay ngay nhé!</p>
                <a href="/Movies/DanhSachPhim" class="btn-book">Xem phim ngay</a>
            </div>
        }
        else
        {
            <div class="ticket-list">
                @foreach (var ve in Model)
                {
                    <div class="ticket-card">
                        <div class="ticket-poster">
                            <img src="~/Content/HinhAnh/@ve.LICHCHIEU.PHIM.POSTER" 
                                 onerror="this.src='https://placehold.co/140x210/1a1a28/555?text=No+Image'" 
                                 alt="@ve.LICHCHIEU.PHIM.TEN_PHIM" />
                        </div>
                        <div class="ticket-info">
                            <div>
                                <div class="ticket-header">
                                    <h3 class="movie-title">@ve.LICHCHIEU.PHIM.TEN_PHIM</h3>
                                    <span class="ticket-status">@ve.TRANGTHAI</span>
                                </div>
                                <div class="ticket-details">
                                    <div class="detail-item">
                                        <i class="bi bi-geo-alt-fill"></i>
                                        <span>@ve.LICHCHIEU.PHONGCHIEU.RAPCHIEU.TEN_RAP - @ve.LICHCHIEU.PHONGCHIEU.TEN_PHONG</span>
                                    </div>
                                    <div class="detail-item">
                                        <i class="bi bi-calendar-event"></i>
                                        <span>@ve.LICHCHIEU.KHUNGGIO.GIOBATDAU.ToString(@"hh\:mm") | @ve.LICHCHIEU.NGAYCHIEU.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="detail-item">
                                        <i class="bi bi-person-video"></i>
                                        <span>Ghế: <strong style="color:#fff">@ve.GHE.SOGHE</strong></span>
                                    </div>
                                    <div class="detail-item">
                                        <i class="bi bi-upc-scan"></i>
                                        <span>Mã vé: @ve.MA_VE</span>
                                    </div>
                                </div>
                            </div>
                            <div class="ticket-footer">
                                <span class="booking-date">Đặt lúc: @ve.DONHANG.NGAYDAT.ToString("dd/MM/yyyy HH:mm")</span>
                                <span class="ticket-price">@String.Format("{0:0,0}", ve.DONGIA)đ</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
