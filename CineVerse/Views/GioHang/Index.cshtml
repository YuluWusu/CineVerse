@model DoAn_QuanLyVeXemPhimTrucTiep.Models.GioHangViewModel
@{
    ViewBag.Title = "Giỏ Hàng Của Bạn";
    Layout = "~/Views/Shared/_Khung.cshtml";
}

<style>
    .cart-page {
        padding: 40px 0 80px;
        min-height: 75vh;
    }

    .cart-card {
        background: var(--bg-card, #161622);
        border: 1px solid var(--border, rgba(255,255,255,0.08));
        border-radius: 14px;
        padding: 24px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .cart-title {
        font-family: var(--font-display, 'DM Sans', sans-serif);
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
    }

    .cart-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

    .cart-table th {
        color: var(--text-muted, #8b8a99);
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 10px 14px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .cart-item-row {
        background: rgba(255,255,255,0.02);
        border-radius: 10px;
        transition: background 0.2s;
    }

    .cart-item-row:hover {
        background: rgba(255,255,255,0.05);
    }

    .cart-item-row td {
        padding: 14px;
        vertical-align: middle;
        color: var(--text-primary, #f0eff5);
        font-size: 14px;
    }

    .item-thumb {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        object-fit: cover;
        background: #0f0f1a;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .qty-input {
        width: 65px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.15);
        color: #fff;
        border-radius: 6px;
        padding: 5px 8px;
        text-align: center;
        font-size: 14px;
        font-weight: 600;
    }

    .qty-input:focus {
        border-color: var(--accent, #e8b84b);
        outline: none;
    }

    .btn-update-qty {
        background: rgba(232, 184, 75, 0.15);
        border: 1px solid rgba(232, 184, 75, 0.3);
        color: var(--accent, #e8b84b);
        border-radius: 6px;
        padding: 5px 10px;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-update-qty:hover {
        background: var(--accent, #e8b84b);
        color: #000;
    }

    .btn-delete-item {
        background: rgba(232, 75, 75, 0.12);
        border: 1px solid rgba(232, 75, 75, 0.3);
        color: #e84b4b;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-delete-item:hover {
        background: #e84b4b;
        color: #fff;
    }

    .order-summary-card {
        background: var(--bg-card, #161622);
        border: 1px solid var(--border, rgba(255,255,255,0.08));
        border-radius: 14px;
        padding: 24px;
        position: sticky;
        top: 90px;
    }

    .summary-title {
        font-size: 18px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        font-size: 14px;
        color: var(--text-muted, #8b8a99);
    }

    .summary-row.total-row {
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px dashed rgba(255,255,255,0.15);
        font-size: 18px;
        font-weight: 700;
        color: #ffffff;
    }

    .total-amount {
        color: var(--accent, #e8b84b);
        font-size: 22px;
    }

    .btn-checkout {
        display: block;
        width: 100%;
        background: linear-gradient(135deg, #e8b84b 0%, #c9972a 100%);
        color: #000000;
        font-weight: 700;
        font-size: 15px;
        text-align: center;
        padding: 14px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        transition: all 0.25s ease;
        text-decoration: none;
        margin-top: 20px;
    }

    .btn-checkout:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(232, 184, 75, 0.35);
        color: #000;
    }

    .promo-input-group {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
    }

    .promo-input-group input {
        flex: 1;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.15);
        color: #fff;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 13px;
        text-transform: uppercase;
    }

    .promo-input-group button {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        color: #fff;
        border-radius: 8px;
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .promo-input-group button:hover {
        background: var(--accent, #e8b84b);
        color: #000;
    }

    .empty-cart-state {
        text-align: center;
        padding: 80px 20px;
    }

    .empty-cart-icon {
        font-size: 64px;
        color: rgba(255,255,255,0.2);
        margin-bottom: 16px;
    }
</style>

<div class="cart-page">
    <div class="container">
        @if (Model == null || Model.Items == null || !Model.Items.Any())
        {
            <div class="cart-card empty-cart-state">
                <div class="empty-cart-icon">
                    <i class="bi bi-cart-x"></i>
                </div>
                <h3 style="color: #fff; font-size: 22px; margin-bottom: 8px;">Giỏ hàng của bạn đang trống</h3>
                <p style="color: var(--text-muted); margin-bottom: 24px;">Hãy khám phá các bộ phim bom tấn và bắp nước hảo hạng tại CinéVerse!</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/Movies/DanhSachPhim" class="btn-gold" style="padding: 10px 24px; text-decoration: none; border-radius: 8px;">
                        <i class="bi bi-film me-1"></i> Khám phá phim
                    </a>
                    <a href="/GioHang/CuaHangBapNuoc" class="btn-ghost" style="padding: 10px 24px; text-decoration: none; border-radius: 8px;">
                        <i class="bi bi-cup-straw me-1"></i> Mua Bắp Nước & Combo
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- CỘT TRÁI: DANH SÁCH SẢN PHẨM & QUẢN LÝ SỐ LƯỢNG -->
                <div class="col-lg-8">
                    <div class="cart-card">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2 class="cart-title mb-0">
                                <i class="bi bi-cart3 text-warning"></i> Giỏ Hàng (@Model.TongSoLuong món)
                            </h2>
                            <form action="/GioHang/XoaGioHang" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa toàn bộ giỏ hàng?');">
                                <button type="submit" class="btn-ghost text-danger border-danger" style="padding: 6px 14px; font-size: 13px; border-radius: 6px;">
                                    <i class="bi bi-trash3 me-1"></i> Xóa toàn bộ
                                </button>
                            </form>
                        </div>

                        <div class="table-responsive">
                            <table class="cart-table">
                                <thead>
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th>Đơn giá</th>
                                        <th style="text-align: center;">Số lượng</th>
                                        <th style="text-align: right;">Thành tiền</th>
                                        <th style="text-align: center;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr class="cart-item-row">
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    <img src="~/Content/HinhAnh/@item.HinhAnh" class="item-thumb"
                                                         onerror="this.src='https://placehold.co/100x100/15151f/888?text=F%26B'" alt="@item.TenSanPham" />
                                                    <div>
                                                        <div class="fw-bold text-white">@item.TenSanPham</div>
                                                        <div class="small text-muted">@item.TuyChon</div>
                                                        @if (item.LoaiItem == "VE")
                                                        {
                                                            <span class="badge bg-warning text-dark mt-1" style="font-size: 10px;">VÉ XEM PHIM</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-info text-dark mt-1" style="font-size: 10px;">F&B COMBO</span>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@item.DonGia.ToString("N0") đ</td>
                                            <td style="text-align: center;">
                                                @if (item.LoaiItem == "VE")
                                                {
                                                    <span class="fw-bold">1</span>
                                                }
                                                else
                                                {
                                                    <form action="/GioHang/CapNhatSoLuong" method="post" class="d-inline-flex align-items-center gap-1">
                                                        <input type="hidden" name="maItem" value="@item.MaItem" />
                                                        <input type="number" name="soLuong" value="@item.SoLuong" min="1" max="99" class="qty-input" />
                                                        <button type="submit" class="btn-update-qty" title="Lưu số lượng">
                                                            <i class="bi bi-check-lg"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </td>
                                            <td style="text-align: right;" class="fw-bold text-warning">
                                                @item.ThanhTien.ToString("N0") đ
                                            </td>
                                            <td style="text-align: center;">
                                                <form action="/GioHang/XoaItem" method="post" onsubmit="return confirm('Xóa món này khỏi giỏ?');">
                                                    <input type="hidden" name="maItem" value="@item.MaItem" />
                                                    <button type="submit" class="btn-delete-item" title="Xóa món này">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- CÁC NÚT ĐIỀU HƯỚNG MUA SẮM TIẾP -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 pt-3 border-top border-secondary border-opacity-25 gap-2">
                            <a href="/Movies/DanhSachPhim" class="btn-ghost" style="padding: 8px 16px; font-size: 13.5px;">
                                <i class="bi bi-arrow-left me-1"></i> Tiếp tục chọn vé xem phim
                            </a>
                            <a href="/GioHang/CuaHangBapNuoc" class="btn-ghost text-warning border-warning" style="padding: 8px 16px; font-size: 13.5px;">
                                <i class="bi bi-plus-circle me-1"></i> Thêm Bắp nước & Snack
                            </a>
                        </div>
                    </div>
                </div>

                <!-- CỘT PHẢI: TỔNG KẾT ĐƠN HÀNG, KHUYẾN MÃI & THANH TOÁN -->
                <div class="col-lg-4">
                    <div class="order-summary-card">
                        <div class="summary-title">
                            <i class="bi bi-receipt me-2 text-warning"></i> Tóm Tắt Đơn Hàng
                        </div>

                        <!-- KHUYẾN MÃI -->
                        <label class="form-label text-muted small fw-bold">MÃ KHUYẾN MÃI / VOUCHER</label>
                        <form action="/GioHang/ApDungKhuyenMai" method="post" class="promo-input-group">
                            <input type="text" name="maKM" value="@Model.MaKhuyenMai" placeholder="Nhập mã KM..." />
                            <button type="submit">Áp dụng</button>
                        </form>

                        @if (!string.IsNullOrEmpty(ViewBag.KMTen as string))
                        {
                            <div class="alert alert-success py-2 px-3 small mb-3">
                                <i class="bi bi-check-circle-fill me-1"></i> @ViewBag.KMTen
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(ViewBag.KMLoi as string))
                        {
                            <div class="alert alert-danger py-2 px-3 small mb-3">
                                <i class="bi bi-exclamation-circle-fill me-1"></i> @ViewBag.KMLoi
                            </div>
                        }

                        <!-- CHI TIẾT TÍNH TIỀN -->
                        <div class="summary-row">
                            <span>Tạm tính (@Model.TongSoLuong món)</span>
                            <span class="text-white fw-bold">@Model.TongTienHang.ToString("N0") đ</span>
                        </div>

                        @if (Model.SoLuongVe > 0)
                        {
                            <div class="summary-row small">
                                <span>- Vé xem phim (@Model.SoLuongVe vé)</span>
                                <span>@Model.Items.Where(i => i.LoaiItem == "VE").Sum(i => i.ThanhTien).ToString("N0") đ</span>
                            </div>
                        }
                        @if (Model.SoLuongBapNuoc > 0)
                        {
                            <div class="summary-row small">
                                <span>- Bắp nước F&B (@Model.SoLuongBapNuoc phần)</span>
                                <span>@Model.Items.Where(i => i.LoaiItem == "BAPNUOC").Sum(i => i.ThanhTien).ToString("N0") đ</span>
                            </div>
                        }

                        @if (Model.ChietKhauThanhVien > 0)
                        {
                            <div class="summary-row text-success">
                                <span>Ưu đãi thành viên (@Model.HangThanhVien -@Model.PhanTramChietKhau%)</span>
                                <span>-@Model.ChietKhauThanhVien.ToString("N0") đ</span>
                            </div>
                        }

                        @if (Model.GiamGiaKhuyenMai > 0)
                        {
                            <div class="summary-row text-danger">
                                <span>Mã giảm giá (@Model.MaKhuyenMai)</span>
                                <span>-@Model.GiamGiaKhuyenMai.ToString("N0") đ</span>
                            </div>
                        }

                        <div class="summary-row total-row">
                            <span>TỔNG THANH TOÁN</span>
                            <span class="total-amount">@Model.TongThanhToan.ToString("N0") đ</span>
                        </div>

                        <!-- FORM XÁC NHẬN ĐẶT HÀNG -->
                        @using (Html.BeginForm("XacNhanDatHang", "GioHang", FormMethod.Post, new { id = "formCheckout" }))
                        {
                            @Html.AntiForgeryToken()

                            <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
                                <h6 class="text-white fw-bold mb-3 small text-uppercase" style="letter-spacing: 0.5px;">Thông tin khách nhận vé</h6>
                                
                                <div class="mb-2">
                                    <input type="text" name="HoTen" value="@Model.HoTen" class="form-control bg-dark text-white border-secondary small" placeholder="Họ và tên..." required />
                                </div>
                                <div class="mb-2">
                                    <input type="tel" name="SoDienThoai" value="@Model.SoDienThoai" class="form-control bg-dark text-white border-secondary small" placeholder="Số điện thoại nhận mã..." required />
                                </div>
                                <div class="mb-3">
                                    <input type="email" name="Email" value="@Model.Email" class="form-control bg-dark text-white border-secondary small" placeholder="Email nhận vé điện tử..." required />
                                </div>

                                <h6 class="text-white fw-bold mb-3 small text-uppercase" style="letter-spacing: 0.5px;">Phương thức thanh toán</h6>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="PhuongThucThanhToan" id="pt_vietqr" value="VietQR" checked>
                                    <label class="form-check-label text-white small" for="pt_vietqr">
                                        <i class="bi bi-qr-code me-1 text-warning"></i> Chuyển khoản nhanh VietQR
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="PhuongThucThanhToan" id="pt_vnpay" value="VNPay">
                                    <label class="form-check-label text-white small" for="pt_vnpay">
                                        <i class="bi bi-credit-card-2-front me-1 text-info"></i> Cổng thanh toán VNPAY-QR
                                    </label>
                                </div>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="radio" name="PhuongThucThanhToan" id="pt_quay" value="TaiQuay">
                                    <label class="form-check-label text-white small" for="pt_quay">
                                        <i class="bi bi-shop me-1 text-success"></i> Thanh toán tiền mặt tại quầy vé
                                    </label>
                                </div>

                                <button type="submit" class="btn-checkout">
                                    <i class="bi bi-shield-check me-1"></i> XÁC NHẬN ĐẶT HÀNG
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

