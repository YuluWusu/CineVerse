@model DoAn_QuanLyVeXemPhimTrucTiep.Models.DONHANG
@{
    ViewBag.Title = "Đặt Hàng Thành Công";
    Layout = "~/Views/Shared/_Khung.cshtml";
}

<style>
    .success-page {
        padding: 50px 0 90px;
    }

    .success-card {
        background: var(--bg-card, #161622);
        border: 1px solid var(--border, rgba(255,255,255,0.08));
        border-radius: 18px;
        padding: 36px;
        max-width: 720px;
        margin: 0 auto;
        box-shadow: 0 16px 40px rgba(0,0,0,0.5);
    }

    .success-header {
        text-align: center;
        padding-bottom: 24px;
        border-bottom: 1px dashed rgba(255,255,255,0.15);
    }

    .success-icon {
        width: 70px;
        height: 70px;
        background: rgba(75, 232, 124, 0.15);
        color: #4be87c;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin: 0 auto 16px;
        border: 2px solid rgba(75, 232, 124, 0.4);
    }

    .checkin-qr-box {
        background: #ffffff;
        padding: 16px;
        border-radius: 12px;
        display: inline-block;
        margin: 20px auto;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

    .checkin-code {
        font-family: monospace;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: 2px;
        color: var(--accent, #e8b84b);
        background: rgba(232, 184, 75, 0.1);
        border: 1px solid rgba(232, 184, 75, 0.3);
        padding: 6px 16px;
        border-radius: 8px;
        display: inline-block;
        margin-top: 8px;
    }
</style>

<div class="success-page">
    <div class="container">
        <div class="success-card">
            <div class="success-header">
                <div class="success-icon">
                    <i class="bi bi-check-lg"></i>
                </div>
                <h2 style="color: #fff; font-weight: 800; margin-bottom: 6px;">ĐẶT HÀNG THÀNH CÔNG!</h2>
                <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 0;">
                    Cảm ơn quý khách đã tin tưởng và sử dụng dịch vụ của CinéVerse.
                </p>
                
                <div class="mt-3">
                    <div class="small text-muted">MÃ CHECK-IN TẠI QUẦY HOẶC CỔNG SOÁT VÉ:</div>
                    <div class="checkin-code">@Model.MACHECKIN</div>
                </div>

                <div class="checkin-qr-box">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=@Model.MACHECKIN" alt="QR Code" width="160" height="160" />
                </div>
            </div>

            <div class="py-4">
                <h5 class="text-warning fw-bold mb-3 small text-uppercase" style="letter-spacing: 1px;">
                    <i class="bi bi-receipt me-1"></i> Chi tiết đơn hàng #@Model.MA_DONHANG
                </h5>

                <div class="row g-2 mb-3 text-muted small">
                    <div class="col-6">Khách hàng: <strong class="text-white">@(Model.KHACHHANG != null ? Model.KHACHHANG.HOTEN : "Khách vãng lai")</strong></div>
                    <div class="col-6 text-end">Thời gian: <strong class="text-white">@Model.NGAYDAT.ToString("dd/MM/yyyy HH:mm")</strong></div>
                    <div class="col-6">Hình thức: <strong class="text-white">@Model.PHUONGTHUCTHANHTOAN</strong></div>
                    <div class="col-6 text-end">Trạng thái: <strong class="text-success">@Model.TRANGTHAITHANHTOAN</strong></div>
                </div>

                <!-- VÉ PHIM NẾU CÓ -->
                @if (Model.VEs != null && Model.VEs.Any())
                {
                    var lc = Model.LICHCHIEU;
                    <div class="p-3 rounded mb-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
                        <div class="fw-bold text-white mb-1">
                            <i class="bi bi-film me-1 text-warning"></i> @(lc?.PHIM?.TEN_PHIM ?? "Vé xem phim")
                        </div>
                        <div class="small text-muted mb-2">
                            Rạp: @(lc?.PHONGCHIEU?.RAPCHIEU?.TEN_RAP) | Phòng: @(lc?.PHONGCHIEU?.TEN_PHONG) | Suất: @(lc?.NGAYCHIEU.ToString("dd/MM/yyyy")) @(lc?.KHUNGGIO?.GIOBATDAU.ToString(@"hh\:mm"))
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var ve in Model.VEs)
                            {
                                <span class="badge bg-secondary py-2 px-3" style="font-size: 12px;">
                                    Ghế @(ve.GHE?.SOGHE ?? ve.MA_GHE) (@(ve.GHE?.LOAIGHE?.TEN_LOAIGHE ?? "Ghế")) - @ve.DONGIA.ToString("N0") đ
                                </span>
                            }
                        </div>
                    </div>
                }

                <!-- BẮP NƯỚC NẾU CÓ -->
                @if (Model.CHITIET_BAPNUOC != null && Model.CHITIET_BAPNUOC.Any())
                {
                    <div class="p-3 rounded mb-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
                        <div class="fw-bold text-white mb-2">
                            <i class="bi bi-cup-straw me-1 text-info"></i> Bắp Nước & Combo Đã Đặt:
                        </div>
                        @foreach (var fnb in Model.CHITIET_BAPNUOC)
                        {
                            <div class="d-flex justify-content-between small text-muted py-1 border-bottom border-secondary border-opacity-10">
                                <span>@fnb.SOLUONG x @(fnb.BAPNUOC?.TEN_SANPHAM ?? fnb.MA_SANPHAM)</span>
                                <span class="text-white fw-bold">@fnb.THANHTIEN.ToString("N0") đ</span>
                            </div>
                        }
                    </div>
                }

                <!-- TỔNG TIỀN -->
                <div class="d-flex justify-content-between align-items-center pt-2">
                    <span class="text-muted">Tổng thanh toán:</span>
                    <span class="text-warning fw-bold" style="font-size: 22px;">@Model.TONGTIEN.ToString("N0") đ</span>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3 pt-3 border-top border-secondary border-opacity-25">
                <a href="/Home/TrangChu" class="btn-gold" style="padding: 10px 24px; text-decoration: none; border-radius: 8px;">
                    <i class="bi bi-house me-1"></i> Về Trang Chủ
                </a>
                <a href="/Movies/DanhSachPhim" class="btn-ghost" style="padding: 10px 24px; text-decoration: none; border-radius: 8px;">
                    <i class="bi bi-film me-1"></i> Tiếp tục đặt vé
                </a>
            </div>
        </div>
    </div>
</div>
