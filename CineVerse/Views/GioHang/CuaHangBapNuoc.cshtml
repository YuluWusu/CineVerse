@model List<DoAn_QuanLyVeXemPhimTrucTiep.Models.BAPNUOC>
@{
    ViewBag.Title = "Cửa Hàng Bắp Nước & Combo F&B - CinéVerse";
    Layout = "~/Views/Shared/_Khung.cshtml";
    var phanLoais = ViewBag.PhanLoaiList as List<string> ?? new List<string>();
    var currentPL = ViewBag.PhanLoai as string;
    var search = ViewBag.Search as string;
}

<style>
    .fnb-hero {
        background: linear-gradient(180deg, rgba(232, 184, 75, 0.1) 0%, rgba(9, 9, 15, 0) 100%);
        padding: 45px 0 25px;
        text-align: center;
        border-bottom: 1px solid var(--border, rgba(255,255,255,0.06));
    }

    .fnb-hero h1 {
        font-family: var(--font-display, 'DM Sans', sans-serif);
        font-size: clamp(28px, 4vw, 38px);
        font-weight: 800;
        color: #ffffff;
        letter-spacing: 0.5px;
    }

    .fnb-hero h1 span {
        color: var(--accent, #e8b84b);
        text-shadow: 0 0 20px rgba(232, 184, 75, 0.3);
    }

    .fnb-hero p {
        color: var(--text-muted, #8b8a99);
        font-size: 14.5px;
        max-width: 620px;
        margin: 10px auto 0;
        line-height: 1.6;
    }

    .fnb-controls {
        padding: 24px 0 32px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .fnb-tabs {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .fnb-tab-btn {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: var(--text-muted, #8b8a99);
        padding: 8px 18px;
        border-radius: 20px;
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s ease;
    }

    .fnb-tab-btn:hover,
    .fnb-tab-btn.active {
        background: var(--accent, #e8b84b);
        color: #0d0c15;
        border-color: var(--accent, #e8b84b);
        box-shadow: 0 4px 15px rgba(232, 184, 75, 0.3);
    }

    .fnb-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
        gap: 24px;
        margin-bottom: 60px;
    }

    .fnb-card {
        background: var(--bg-card, #161622);
        border: 1px solid var(--border, rgba(255,255,255,0.08));
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: all 0.25s ease;
    }

    .fnb-card:hover {
        transform: translateY(-5px);
        border-color: rgba(232, 184, 75, 0.4);
        box-shadow: 0 12px 30px rgba(0,0,0,0.45);
    }

    .fnb-img-wrap {
        width: 100%;
        height: 185px;
        overflow: hidden;
        background: #0f0f1a;
        position: relative;
    }

    .fnb-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .fnb-card:hover .fnb-img-wrap img {
        transform: scale(1.06);
    }

    .fnb-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(9, 9, 15, 0.85);
        backdrop-filter: blur(8px);
        color: var(--accent, #e8b84b);
        font-size: 11px;
        font-weight: 700;
        padding: 4px 11px;
        border-radius: 12px;
        border: 1px solid rgba(232,184,75,0.3);
    }

    .fnb-body {
        padding: 18px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .fnb-name {
        font-size: 16px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 6px;
    }

    .fnb-desc {
        font-size: 12.5px;
        color: var(--text-muted, #8b8a99);
        line-height: 1.5;
        margin-bottom: 12px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 38px;
    }

    .fnb-price-tag {
        font-size: 20px;
        font-weight: 800;
        color: var(--accent, #e8b84b);
        margin-bottom: 14px;
        transition: color 0.2s;
    }

    .fnb-form {
        margin-top: auto;
    }

    .fnb-select-size {
        width: 100%;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.15);
        color: #fff;
        border-radius: 8px;
        padding: 7px 10px;
        font-size: 13px;
        margin-bottom: 12px;
        outline: none;
        transition: border-color 0.2s;
    }

    .fnb-select-size:focus {
        border-color: var(--accent, #e8b84b);
    }

    .fnb-select-size option {
        background: #161622;
        color: #fff;
    }

    .fnb-action-row {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    /* Stepper Số lượng */
    .qty-stepper {
        display: flex;
        align-items: center;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 8px;
        overflow: hidden;
        height: 38px;
    }

    .btn-step {
        background: transparent;
        border: none;
        color: #fff;
        width: 28px;
        height: 100%;
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.15s;
    }

    .btn-step:hover {
        background: rgba(255,255,255,0.1);
        color: var(--accent, #e8b84b);
    }

    .fnb-qty {
        width: 38px;
        background: transparent;
        border: none;
        color: #fff;
        text-align: center;
        font-size: 13.5px;
        font-weight: 700;
        outline: none;
        -moz-appearance: textfield;
    }

    .fnb-qty::-webkit-inner-spin-button, 
    .fnb-qty::-webkit-outer-spin-button { 
        -webkit-appearance: none; 
        margin: 0; 
    }

    .btn-add-cart {
        flex: 1;
        height: 38px;
        background: rgba(232, 184, 75, 0.15);
        border: 1px solid rgba(232, 184, 75, 0.4);
        color: var(--accent, #e8b84b);
        font-weight: 700;
        font-size: 13px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .btn-add-cart:hover {
        background: var(--accent, #e8b84b);
        color: #0d0c15;
        box-shadow: 0 4px 12px rgba(232, 184, 75, 0.35);
    }

    .btn-add-cart.added {
        background: #28a745 !important;
        border-color: #28a745 !important;
        color: #fff !important;
    }

    /* Floating Toast Notification */
    .fnb-toast {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: #1b1b2a;
        border: 1px solid rgba(232, 184, 75, 0.4);
        border-radius: 12px;
        padding: 16px 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        z-index: 9999;
        display: none;
        animation: slideUpToast 0.3s ease-out;
        max-width: 380px;
    }

    @@keyframes slideUpToast {
        from { transform: translateY(40px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    /* Floating Cart Shortcut Pill */
    .floating-cart-pill {
        position: fixed;
        bottom: 30px;
        left: 30px;
        background: linear-gradient(135deg, #e8b84b 0%, #ffc107 100%);
        color: #0d0c15;
        font-weight: 700;
        padding: 12px 22px;
        border-radius: 30px;
        box-shadow: 0 8px 24px rgba(232, 184, 75, 0.4);
        z-index: 999;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .floating-cart-pill:hover {
        transform: translateY(-3px);
        color: #000;
        box-shadow: 0 12px 28px rgba(232, 184, 75, 0.55);
    }
</style>

<div class="fnb-hero">
    <div class="container">
        <h1>CỬA HÀNG <span>BẮP NƯỚC & COMBO F&B</span></h1>
        <p>Thưởng thức bắp rang bơ nóng hổi giòn rụm cùng nước uống mát lạnh, tiếp thêm hứng khởi cho từng thước phim điện ảnh đỉnh cao!</p>
    </div>
</div>

<div class="container">
    <div class="fnb-controls">
        <!-- TABS PHÂN LOẠI F&B -->
        <div class="fnb-tabs">
            <a href="@Url.Action("CuaHangBapNuoc", "GioHang")" class="fnb-tab-btn @(string.IsNullOrEmpty(currentPL) ? "active" : "")">
                <i class="bi bi-grid-fill me-1"></i> Tất cả
            </a>
            @foreach (var pl in phanLoais)
            {
                <a href="@Url.Action("CuaHangBapNuoc", "GioHang", new { phanLoai = pl })" class="fnb-tab-btn @(currentPL == pl ? "active" : "")">
                    @pl
                </a>
            }
        </div>

        <!-- TÌM KIẾM SẢN PHẨM -->
        <form action="@Url.Action("CuaHangBapNuoc", "GioHang")" method="get" class="d-flex gap-2">
            @if (!string.IsNullOrEmpty(currentPL))
            {
                <input type="hidden" name="phanLoai" value="@currentPL" />
            }
            <input type="text" name="search" value="@search" placeholder="Tìm bắp, nước, combo..."
                   class="form-control form-control-sm bg-dark text-white border-secondary" style="width: 220px;" />
            <button type="submit" class="btn btn-sm btn-outline-warning">
                <i class="bi bi-search"></i>
            </button>
        </form>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-emoji-frown" style="font-size: 52px; opacity: 0.35;"></i>
            <h4 class="mt-3 text-white">Không tìm thấy sản phẩm F&B phù hợp</h4>
            <p class="small text-muted">Thử tìm kiếm với từ khóa khác hoặc quay lại danh sách tất cả món ăn.</p>
            <a href="@Url.Action("CuaHangBapNuoc", "GioHang")" class="btn-gold mt-2 d-inline-block px-4 py-2 text-decoration-none rounded">
                Xem tất cả món ăn
            </a>
        </div>
    }
    else
    {
        <div class="fnb-grid">
            @foreach (var item in Model)
            {
                string priceId = "price_" + item.MA_SANPHAM.Trim();
                <div class="fnb-card">
                    <div class="fnb-img-wrap">
                        <img src="~/Content/HinhAnh/@item.HinhAnh" onerror="this.src='https://placehold.co/300x200/15151f/888?text=F%26B'" alt="@item.TEN_SANPHAM" />
                        <span class="fnb-badge">@item.PHANLOAI</span>
                    </div>

                    <div class="fnb-body">
                        <div class="fnb-name">@item.TEN_SANPHAM</div>
                        <div class="fnb-desc" title="@item.MOTA">@item.MOTA</div>
                        <div class="fnb-price-tag" id="@priceId" data-base="@item.GIABAN">@item.GIABAN.ToString("N0") đ</div>

                        <!-- FORM CHỌN TÙY CHỌN SIZE & SỐ LƯỢNG (AJAX + FALLBACK) -->
                        <form action="@Url.Action("ThemBapNuocVaoGio", "GioHang")" method="post" class="fnb-form fnb-ajax-form">
                            <input type="hidden" name="maSanPham" value="@item.MA_SANPHAM" />
                            <input type="hidden" name="returnUrl" value="@Request.RawUrl" />
                            
                            <label class="form-label text-muted small mb-1" style="font-size: 11px;">Kích cỡ / Tùy chọn:</label>
                            <select name="tuyChon" class="fnb-select-size" data-target="@priceId" data-base="@item.GIABAN">
                                <option value="Size Vừa (Tiêu chuẩn)" data-delta="0">Size Vừa (Tiêu chuẩn)</option>
                                <option value="Size Lớn (+10.000đ)" data-delta="10000">Size Lớn (+10.000 đ)</option>
                                <option value="Size Khổng lồ (+20.000đ)" data-delta="20000">Size Khổng lồ (+20.000 đ)</option>
                                <option value="Size Nhỏ (-10.000đ)" data-delta="-10000">Size Nhỏ (-10.000 đ)</option>
                            </select>

                            <div class="fnb-action-row">
                                <div class="qty-stepper">
                                    <button type="button" class="btn-step btn-minus">-</button>
                                    <input type="number" name="soLuong" value="1" min="1" max="50" class="fnb-qty" readonly />
                                    <button type="button" class="btn-step btn-plus">+</button>
                                </div>
                                <button type="submit" class="btn-add-cart">
                                    <i class="bi bi-cart-plus"></i> <span class="btn-text">Thêm vào giỏ</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Nút tắt mở Giỏ hàng nhanh ở góc dưới màn hình -->
<a href="@Url.Action("Index", "GioHang")" class="floating-cart-pill" id="floatingCartBtn">
    <i class="bi bi-bag-check-fill" style="font-size: 18px;"></i>
    <span>Xem Giỏ Hàng</span>
</a>

<!-- Hộp thông báo Toast nổi -->
<div class="fnb-toast" id="fnbToast">
    <div class="d-flex align-items-start gap-3">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 24px;"></i>
        <div class="flex-grow-1">
            <h6 class="text-white mb-1" style="font-size: 14.5px; font-weight: 700;">Đã thêm vào giỏ hàng!</h6>
            <p class="text-muted small mb-2" id="toastMessageContent" style="font-size: 12.5px;"></p>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary text-white py-1 px-2" style="font-size: 11.5px;" onclick="closeFnbToast()">
                    Tiếp tục mua
                </button>
                <a href="@Url.Action("Index", "GioHang")" class="btn btn-sm btn-warning text-dark py-1 px-3 fw-bold" style="font-size: 11.5px;">
                    Đi đến giỏ hàng
                </a>
            </div>
        </div>
        <button type="button" class="btn-close btn-close-white" style="font-size: 11px;" onclick="closeFnbToast()"></button>
    </div>
</div>

@section scripts {
<script>
    // 1. Tự động tính lại đơn giá khi thay đổi Size
    document.querySelectorAll('.fnb-select-size').forEach(function(select) {
        select.addEventListener('change', function() {
            var targetId = this.getAttribute('data-target');
            var basePrice = parseFloat(this.getAttribute('data-base')) || 0;
            var selectedOption = this.options[this.selectedIndex];
            var delta = parseFloat(selectedOption.getAttribute('data-delta')) || 0;
            var newPrice = Math.max(0, basePrice + delta);

            var priceElem = document.getElementById(targetId);
            if (priceElem) {
                priceElem.textContent = new Intl.NumberFormat('vi-VN').format(newPrice) + ' đ';
            }
        });
    });

    // 2. Stepper tăng giảm số lượng (+ / -)
    document.querySelectorAll('.btn-minus').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var input = this.parentElement.querySelector('.fnb-qty');
            var val = parseInt(input.value) || 1;
            if (val > 1) {
                input.value = val - 1;
            }
        });
    });

    document.querySelectorAll('.btn-plus').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var input = this.parentElement.querySelector('.fnb-qty');
            var val = parseInt(input.value) || 1;
            if (val < 50) {
                input.value = val + 1;
            }
        });
    });

    // 3. Xử lý Thêm vào giỏ bằng AJAX mượt mà
    document.querySelectorAll('.fnb-ajax-form').forEach(function(form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            var submitBtn = form.querySelector('.btn-add-cart');
            var btnText = submitBtn.querySelector('.btn-text');
            var origText = btnText ? btnText.textContent : 'Thêm vào giỏ';

            // Loading state
            submitBtn.disabled = true;
            if (btnText) btnText.textContent = 'Đang thêm...';

            var formData = new FormData(form);

            fetch(form.action, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                submitBtn.disabled = false;
                if (data.success) {
                    // Update button UI
                    submitBtn.classList.add('added');
                    if (btnText) btnText.textContent = 'Đã thêm ✓';

                    setTimeout(function() {
                        submitBtn.classList.remove('added');
                        if (btnText) btnText.textContent = origText;
                    }, 1800);

                    // Cập nhật Badge giỏ hàng trên Header Navbar
                    var badges = document.querySelectorAll('.cv-cart-badge');
                    badges.forEach(function(badge) {
                        badge.textContent = data.totalItems > 99 ? '99+' : data.totalItems;
                        badge.style.display = data.totalItems > 0 ? 'flex' : 'none';
                        badge.classList.remove('animate__pulse');
                        void badge.offsetWidth;
                        badge.classList.add('animate__pulse');
                    });

                    // Hiển thị Toast thông báo
                    showFnbToast(data.message);
                } else {
                    alert(data.message || 'Không thể thêm sản phẩm vào giỏ hàng.');
                    if (btnText) btnText.textContent = origText;
                }
            })
            .catch(function(err) {
                console.error(err);
                submitBtn.disabled = false;
                if (btnText) btnText.textContent = origText;
                // Fallback submit form thông thường nếu mạng lỗi
                form.submit();
            });
        });
    });

    // Toast helper
    var toastTimer = null;
    function showFnbToast(msg) {
        var toast = document.getElementById('fnbToast');
        var msgElem = document.getElementById('toastMessageContent');
        if (!toast || !msgElem) return;

        msgElem.textContent = msg;
        toast.style.display = 'block';

        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function() {
            closeFnbToast();
        }, 5000);
    }

    function closeFnbToast() {
        var toast = document.getElementById('fnbToast');
        if (toast) toast.style.display = 'none';
    }
</script>
}
