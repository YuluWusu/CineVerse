@{
    ViewBag.Title = "Danh Sách Phim";
    Layout = "~/Views/Shared/_Khung.cshtml";
    var phims = (ViewBag.DanhSachPhim as List<DoAn_QuanLyVeXemPhimTrucTiep.Models.PHIM>) ?? (Model as List<DoAn_QuanLyVeXemPhimTrucTiep.Models.PHIM>) ?? new List<DoAn_QuanLyVeXemPhimTrucTiep.Models.PHIM>();
    var trangThai = ViewBag.TrangThai as string ?? "Đang chiếu";
    var searchKeyword = ViewBag.Search as string;
    var theLoais = ViewBag.TheLoais as List<DoAn_QuanLyVeXemPhimTrucTiep.Models.THELOAI> ?? new List<DoAn_QuanLyVeXemPhimTrucTiep.Models.THELOAI>();
    var currentMaTL = ViewBag.MaTheLoai as string;
    var currentSort = ViewBag.SortOrder as string;
}

@section Styles {
    <style>
        /* ===== BỘ LỌC TRẠNG THÁI CHÍNH ===== */
        .filter-tabs-wrap {
            background: var(--bg-deep, #0f0f1a);
            border-bottom: 1px solid var(--border, rgba(255,255,255,0.08));
            padding: 24px 0 0;
        }

        .filter-tabs {
            display: flex;
            justify-content: center;
            gap: 12px;
            overflow-x: auto;
        }

        .filter-tab {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 32px;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 0.5px;
            color: var(--text-muted, #8b8a99);
            border-bottom: 3px solid transparent;
            text-decoration: none;
            transition: all .2s;
            white-space: nowrap;
        }

        .filter-tab:hover {
            color: var(--text-primary, #f0eff5);
        }

        .filter-tab.active {
            color: var(--accent, #e8b84b);
            border-bottom-color: var(--accent, #e8b84b);
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .status-dot.dang {
            background: #4be87c;
            box-shadow: 0 0 6px rgba(75, 232, 124, 0.5);
        }

        .status-dot.sap {
            background: var(--accent, #e8b84b);
            box-shadow: 0 0 6px rgba(232, 184, 75, 0.5);
        }

        .status-dot.xong {
            background: var(--text-muted, #8b8a99);
        }

        /* ===== THANH CÔNG CỤ BỘ LỌC THỂ LOẠI & SẮP XẾP (TIÊU CHÍ BAREM) ===== */
        .catalog-toolbar {
            background: rgba(255, 255, 255, 0.02);
            border-bottom: 1px solid var(--border, rgba(255,255,255,0.06));
            padding: 18px 0;
            margin-bottom: 30px;
        }

        .genre-chips-strip {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 4px;
            scrollbar-width: thin;
        }

        .genre-chip {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-muted, #8b8a99);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .genre-chip:hover {
            background: rgba(232, 184, 75, 0.15);
            border-color: rgba(232, 184, 75, 0.4);
            color: var(--accent, #e8b84b);
        }

        .genre-chip.active {
            background: var(--accent, #e8b84b);
            border-color: var(--accent, #e8b84b);
            color: #000000;
            font-weight: 700;
        }

        .sort-select {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: var(--text-primary, #ffffff);
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 13px;
            outline: none;
            cursor: pointer;
        }

        .sort-select option {
            background: #161622;
            color: #fff;
        }

        /* ===== LƯỚI DANH SÁCH PHIM & HIỆU ỨNG HOVER ĐỈNH CAO ===== */
        .movies-page {
            padding: 10px 0 70px;
        }

        .movies-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
            gap: 24px;
        }

        .movie-card {
            display: flex;
            flex-direction: column;
            height: 100%;
            background: var(--bg-card, #161622);
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid var(--border, rgba(255,255,255,0.08));
            transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
            cursor: pointer;
            position: relative;
        }

        .movie-card:hover {
            transform: translateY(-8px) scale(1.02);
            border-color: rgba(232, 184, 75, 0.45);
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.65), 0 0 15px rgba(232, 184, 75, 0.15);
        }

        .movie-poster {
            position: relative;
            aspect-ratio: 2/3;
            overflow: hidden;
            background: #09090f;
        }

        .movie-poster img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.45s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        .movie-card:hover .movie-poster img {
            transform: scale(1.08);
        }

        .poster-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(0deg, rgba(9,9,15,0.92) 0%, transparent 60%);
            opacity: 0;
            transition: opacity 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .movie-card:hover .poster-overlay {
            opacity: 1;
        }

        .play-btn {
            width: 52px;
            height: 52px;
            background: var(--accent, #e8b84b);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #000;
            transform: scale(0.8);
            transition: transform 0.25s;
            box-shadow: 0 4px 16px rgba(232, 184, 75, 0.5);
        }

        .movie-card:hover .play-btn {
            transform: scale(1);
        }

        .badge-wrap {
            position: absolute;
            top: 10px;
            left: 10px;
            z-index: 2;
        }

        .rating-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(9, 9, 15, 0.85);
            backdrop-filter: blur(8px);
            color: var(--accent, #e8b84b);
            font-size: 11px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 6px;
            border: 1px solid rgba(232, 184, 75, 0.3);
            display: flex;
            align-items: center;
            gap: 4px;
            z-index: 2;
        }

        .movie-info {
            padding: 14px 16px 16px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .movie-title {
            font-size: 15px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 6px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.35;
            transition: color 0.2s;
        }

        .movie-card:hover .movie-title {
            color: var(--accent, #e8b84b);
        }

        .movie-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            color: var(--text-muted, #8b8a99);
            margin-bottom: 10px;
        }

        .movie-genre {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 120px;
        }

        .movie-dur {
            display: flex;
            align-items: center;
            gap: 3px;
            flex-shrink: 0;
        }

        .movie-price-tag {
            font-size: 13.5px;
            font-weight: 700;
            color: var(--accent, #e8b84b);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .btn-dat-ve {
            display: block;
            width: 100%;
            text-align: center;
            background: rgba(232, 184, 75, 0.12);
            border: 1px solid rgba(232, 184, 75, 0.4);
            color: var(--accent, #e8b84b);
            font-size: 13px;
            font-weight: 700;
            padding: 9px;
            border-radius: 8px;
            cursor: pointer;
            transition: all .2s;
            letter-spacing: 0.5px;
            text-decoration: none;
            margin-top: auto;
        }

        .btn-dat-ve:hover {
            background: var(--accent, #e8b84b);
            color: #000;
            border-color: var(--accent, #e8b84b);
        }

        .btn-dat-ve.disabled {
            border-color: rgba(255,255,255,.1);
            color: var(--text-muted);
            cursor: default;
            pointer-events: none;
        }
    </style>
}

<!-- BỘ LỌC TRẠNG THÁI -->
<div class="filter-tabs-wrap">
    <div class="filter-tabs">
        <a href="@Url.Action("DanhSachPhim", "Movies", new { trangthai = "Đang chiếu", maTheLoai = currentMaTL, sortOrder = currentSort })"
           class="filter-tab @(trangThai == "Đang chiếu" ? "active" : "")">
            <span class="status-dot dang"></span> Phim Đang Chiếu
        </a>
        <a href="@Url.Action("DanhSachPhim", "Movies", new { trangthai = "Sắp chiếu", maTheLoai = currentMaTL, sortOrder = currentSort })"
           class="filter-tab @(trangThai == "Sắp chiếu" ? "active" : "")">
            <span class="status-dot sap"></span> Phim Sắp Chiếu
        </a>
        <a href="@Url.Action("DanhSachPhim", "Movies", new { trangthai = "Ngừng chiếu", maTheLoai = currentMaTL, sortOrder = currentSort })"
           class="filter-tab @(trangThai == "Ngừng chiếu" ? "active" : "")">
            <span class="status-dot xong"></span> Đã Kết Thúc
        </a>
        <a href="@Url.Action("DanhSachPhim", "Movies", new { trangthai = "TatCa", maTheLoai = currentMaTL, sortOrder = currentSort })"
           class="filter-tab @(trangThai == "TatCa" ? "active" : "")">
            <i class="bi bi-grid"></i> Tất Cả Phim
        </a>
    </div>
</div>

<!-- TOOLBAR: LỌC THỂ LOẠI (CSDL) & SẮP XẾP (SORT) -->
<div class="catalog-toolbar">
    <div class="container">
        <div class="row align-items-center g-3">
            <!-- DẢI CHIPS THỂ LOẠI (LẤY TỪ BẢNG THELOAI) -->
            <div class="col-lg-8 col-md-7">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small fw-bold text-uppercase d-none d-sm-inline" style="letter-spacing: 0.5px; font-size: 11px;">
                        <i class="bi bi-tags me-1"></i> Thể loại:
                    </span>
                    <div class="genre-chips-strip">
                        <a href="@Url.Action("DanhSachPhim", "Movies", new { trangthai = trangThai, maTheLoai = "", sortOrder = currentSort })"
                           class="genre-chip @(string.IsNullOrEmpty(currentMaTL) ? "active" : "")">
                            Tất cả
                        </a>
                        @foreach (var tl in theLoais)
                        {
                            <a href="@Url.Action("DanhSachPhim", "Movies", new { trangthai = trangThai, maTheLoai = tl.MA_THELOAI.Trim(), sortOrder = currentSort })"
                               class="genre-chip @(currentMaTL == tl.MA_THELOAI.Trim() ? "active" : "")">
                                @tl.TEN_THELOAI
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- DROPDOWN SẮP XẾP DANH SÁCH PHIM -->
            <div class="col-lg-4 col-md-5">
                <form action="@Url.Action("DanhSachPhim", "Movies")" method="get" class="d-flex align-items-center justify-content-md-end gap-2">
                    <input type="hidden" name="trangthai" value="@trangThai" />
                    @if (!string.IsNullOrEmpty(currentMaTL))
                    {
                        <input type="hidden" name="maTheLoai" value="@currentMaTL" />
                    }
                    @if (!string.IsNullOrEmpty(searchKeyword))
                    {
                        <input type="hidden" name="search" value="@searchKeyword" />
                    }
                    <label class="text-muted small mb-0 fw-bold d-none d-sm-inline" style="font-size: 11px; white-space: nowrap;">
                        <i class="bi bi-sort-down me-1"></i> Sắp xếp:
                    </label>
                    <select name="sortOrder" class="sort-select" onchange="this.form.submit()">
                        <option value="ngay_desc" @(currentSort == "ngay_desc" || string.IsNullOrEmpty(currentSort) ? "selected" : "")>Mới nhất (Khởi chiếu)</option>
                        <option value="ten_asc" @(currentSort == "ten_asc" ? "selected" : "")>Tên phim: A &rarr; Z</option>
                        <option value="ten_desc" @(currentSort == "ten_desc" ? "selected" : "")>Tên phim: Z &rarr; A</option>
                        <option value="thoiluong_asc" @(currentSort == "thoiluong_asc" ? "selected" : "")>Thời lượng: Tăng dần</option>
                        <option value="thoiluong_desc" @(currentSort == "thoiluong_desc" ? "selected" : "")>Thời lượng: Giảm dần</option>
                    </select>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="movies-page">
    <div class="container">
        <!-- THÔNG BÁO BỘ LỌC TÌM KIẾM HOẶC THỂ LOẠI -->
        @if (!string.IsNullOrEmpty(searchKeyword) || !string.IsNullOrEmpty(currentMaTL))
        {
            <div style="margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.04); border: 1px solid var(--border); padding: 14px 20px; border-radius: 10px;">
                <div>
                    @if (!string.IsNullOrEmpty(searchKeyword))
                    {
                        <span style="color: var(--text-muted);">Tìm kiếm: </span>
                        <strong style="color: var(--accent); font-size: 15px;">"@searchKeyword"</strong>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.TenTheLoai as string))
                    {
                        <span style="color: var(--text-muted); margin-left: 10px;">Thể loại: </span>
                        <strong style="color: var(--accent); font-size: 15px;">@ViewBag.TenTheLoai</strong>
                    }
                    <span style="color: var(--text-muted); margin-left: 8px;">(@phims.Count phim)</span>
                </div>
                <a href="@Url.Action("DanhSachPhim", "Movies")" class="btn-ghost" style="padding: 6px 14px; font-size: 13px; text-decoration: none;">
                    <i class="bi bi-x-circle me-1"></i> Xóa tất cả bộ lọc
                </a>
            </div>
        }

        <!-- DANH SÁCH PHIM -->
        @if (phims == null || phims.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-film" style="font-size: 56px; color: rgba(255,255,255,0.2);"></i>
                <h3 class="text-white mt-3">Không tìm thấy phim phù hợp</h3>
                <p style="color: var(--text-muted); margin-top: 8px;">Vui lòng thử chọn thể loại khác hoặc xóa từ khóa tìm kiếm.</p>
                <a href="@Url.Action("DanhSachPhim", "Movies")" class="btn-gold mt-2 d-inline-block px-4 py-2 text-decoration-none rounded">
                    Xem tất cả phim
                </a>
            </div>
        }
        else
        {
            <div class="movies-grid">
                @foreach (var phim in phims)
                {
                    var theloaiList = phim.THELOAIs.Select(t => t.TEN_THELOAI).ToList() ?? new List<string>();
                    var badgeClass = !string.IsNullOrEmpty(phim.GIOI_HAN_TUOI) ? phim.GIOI_HAN_TUOI.ToLower().Replace(" ", "") : "p";

                    <div class="movie-card" onclick="location.href='@Url.Action("ChiTietPhim", "Movies", new { id = phim.MA_PHIM })'">
                        <div class="movie-poster">
                            <img src="~/Content/HinhAnh/@phim.POSTER"
                                 onerror="this.src='https://placehold.co/300x450/1a0a2e/ffffff?text=CineVerse'"
                                 alt="@phim.TEN_PHIM" />
                            <div class="poster-overlay">
                                <div class="play-btn"><i class="bi bi-play-fill"></i></div>
                            </div>
                            
                            <!-- BADGE GIỚI HẠN ĐỘ TUỔI -->
                            @if (!string.IsNullOrEmpty(phim.GIOI_HAN_TUOI))
                            {
                                <div class="badge-wrap">
                                    <span class="badge-age badge-@badgeClass">@phim.GIOI_HAN_TUOI</span>
                                </div>
                            }

                            <!-- BADGE ĐIỂM SAO ĐÁNH GIÁ -->
                            <div class="rating-badge">
                                <i class="bi bi-star-fill text-warning"></i> 5.0
                            </div>
                        </div>

                        <div class="movie-info">
                            <div class="movie-title" title="@phim.TEN_PHIM">@phim.TEN_PHIM</div>
                            
                            <div class="movie-meta">
                                <span class="movie-genre" title="@string.Join(", ", theloaiList)">
                                    @(theloaiList.Any() ? string.Join(", ", theloaiList) : "Đa thể loại")
                                </span>
                                @if (phim.THOILUONG.HasValue)
                                {
                                    <span class="movie-dur">
                                        <i class="bi bi-clock"></i> @phim.THOILUONG'
                                    </span>
                                }
                            </div>

                            <!-- GIÁ VÉ CƠ BẢN NỔI BẬT THEO TIÊU CHÍ BAREM -->
                            <div class="movie-price-tag">
                                <span><i class="bi bi-ticket-detailed me-1"></i> Giá vé từ:</span>
                                <span>75.000 đ</span>
                            </div>

                            @if (phim.TRANGTHAI == "Đang chiếu")
                            {
                                <a href="@Url.Action("ChiTietPhim", "Movies", new { id = phim.MA_PHIM })"
                                   class="btn-dat-ve" onclick="event.stopPropagation()">
                                    <i class="bi bi-ticket-perforated-fill me-1"></i> ĐẶT VÉ NGAY
                                </a>
                            }
                            else if (phim.TRANGTHAI == "Sắp chiếu")
                            {
                                <a href="@Url.Action("ChiTietPhim", "Movies", new { id = phim.MA_PHIM })"
                                   class="btn-dat-ve" onclick="event.stopPropagation()">
                                    <i class="bi bi-bell me-1"></i>
                                    @(phim.NGAYKHOICHIEU.HasValue ? "Khởi chiếu " + phim.NGAYKHOICHIEU.Value.ToString("dd/MM") : "Xem Chi Tiết")
                                </a>
                            }
                            else
                            {
                                <span class="btn-dat-ve disabled">Đã kết thúc chiếu</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
