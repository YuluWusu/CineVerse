@{
    ViewBag.Title = "Chi tiết phim";
    Layout = "~/Views/Shared/_Khung.cshtml";
}
@model DoAn_QuanLyVeXemPhimTrucTiep.Models.PHIM

@section Styles {
    <style>
       
        .detail-backdrop {
            position: relative;
            width: 100%;
            min-height: 520px;
            overflow: hidden;
            display: flex;
            align-items: flex-end;
        }

        .backdrop-bg {
            position: absolute;
            inset: 0;
            z-index: 0;
        }

            .backdrop-bg img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                filter: brightness(.22) blur(3px);
                transform: scale(1.05);
            }

        .backdrop-gradient {
            position: absolute;
            inset: 0;
            background: linear-gradient( 90deg, rgba(9,9,15,.95) 0%, rgba(9,9,15,.75) 45%, rgba(9,9,15,.3) 100% );
        }

        .backdrop-gradient-bottom {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 180px;
            background: linear-gradient(0deg, rgba(9,9,15,1) 0%, transparent 100%);
        }

        .detail-main {
            position: relative;
            z-index: 1;
            width: 100%;
            padding: 56px 0 48px;
        }

        .detail-inner {
            display: flex;
            gap: 48px;
            align-items: flex-start;
        }

        .detail-poster {
            flex-shrink: 0;
            width: 240px;
        }

        .poster-img-wrap {
            width: 240px;
            aspect-ratio: 2/3;
            border-radius: 14px;
            overflow: hidden;
            border: 2px solid rgba(232,184,75,.25);
            position: relative;
        }

            .poster-img-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform .4s;
            }

            .poster-img-wrap:hover img {
                transform: scale(1.04);
            }

        .poster-overlay {
            position: absolute;
            inset: 0;
            background: rgba(9,9,15,.55);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity .3s;
            cursor: pointer;
        }

        .poster-img-wrap:hover .poster-overlay {
            opacity: 1;
        }

        .play-icon {
            width: 64px;
            height: 64px;
            background: var(--accent);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            color: #000;
            transition: transform .2s;
        }

            .play-icon:hover {
                transform: scale(1.1);
            }

        .poster-actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 16px;
        }

        .btn-book-now {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--accent);
            color: #000;
            font-weight: 700;
            font-size: 14px;
            letter-spacing: 0.5px;
            padding: 13px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            text-decoration: none;
            transition: all .2s;
        }

            .btn-book-now:hover {
                background: var(--accent-dim);
                color: #000;
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(232,184,75,.3);
            }

        .btn-trailer {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: rgba(255,255,255,.07);
            color: var(--text-primary);
            font-size: 13px;
            font-weight: 500;
            padding: 11px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,.13);
            cursor: pointer;
            text-decoration: none;
            transition: all .2s;
        }

            .btn-trailer:hover {
                background: rgba(255,255,255,.13);
                color: var(--accent);
                border-color: var(--accent);
            }

        .status-badge {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            padding: 16px;
            border-radius: 10px;
            text-align: center;
            margin-top: 4px;
        }

            .status-badge.sap {
                background: rgba(232,184,75,.1);
                border: 1px solid rgba(232,184,75,.25);
            }

            .status-badge.xong {
                background: rgba(255,255,255,.05);
                border: 1px solid rgba(255,255,255,.1);
            }

            .status-badge i {
                font-size: 22px;
            }

            .status-badge.sap i {
                color: var(--accent);
            }

            .status-badge.xong i {
                color: var(--text-muted);
            }

            .status-badge span {
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 1px;
            }

            .status-badge.sap span {
                color: var(--accent);
            }

            .status-badge.xong span {
                color: var(--text-muted);
            }

            .status-badge small {
                font-size: 11px;
                color: var(--text-muted);
            }

        .detail-info {
            flex: 1;
            min-width: 0;
        }

        .detail-breadcrumb {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 18px;
        }

            .detail-breadcrumb a {
                color: var(--text-muted);
                transition: color .2s;
            }

                .detail-breadcrumb a:hover {
                    color: var(--accent);
                }

        .age-badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1px;
            margin-bottom: 14px;
        }

        .badge-p {
            background: #2ecc71;
            color: #000;
        }

        .badge-t13 {
            background: #f1c40f;
            color: #000;
        }

        .badge-t16 {
            background: #e67e22;
            color: #fff;
        }

        .badge-t18 {
            background: #e74c3c;
            color: #fff;
        }

        .detail-title {
            font-family: var(--font-display);
            font-size: clamp(28px, 4vw, 50px);
            letter-spacing: 2px;
            line-height: 1.05;
            margin-bottom: 10px;
            color: var(--text-primary);
        }

        .detail-stats {
            display: flex;
            gap: 28px;
            flex-wrap: wrap;
            margin-bottom: 24px;
            padding-bottom: 24px;
            border-bottom: 1px solid var(--border);
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .stat-item i {
                font-size: 16px;
                color: var(--accent);
            }

        .stat-value {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .stat-unit {
            font-size: 13px;
            color: var(--text-muted);
        }

        .detail-rows {
            margin-bottom: 20px;
        }

        .detail-row {
            display: flex;
            align-items: baseline;
            gap: 12px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }

        .detail-label {
            width: 100px;
            flex-shrink: 0;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: var(--accent);
        }

        .detail-value {
            flex: 1;
            font-size: 14px;
            color: var(--text-muted);
            line-height: 1.6;
        }

        .genre-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
        }

        .genre-tag {
            background: rgba(232,184,75,.1);
            border: 1px solid rgba(232,184,75,.2);
            color: var(--accent);
            font-size: 11px;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 20px;
            transition: all .2s;
        }

            .genre-tag:hover {
                background: var(--accent);
                color: #000;
            }

        .status-inline {
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .status-inline.dang {
                color: #4be87c;
            }

            .status-inline.sap {
                color: var(--accent);
            }

            .status-inline.xong {
                color: var(--text-muted);
            }

        .detail-desc {
            background: rgba(255,255,255,.03);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 20px 24px;
            margin-top: 4px;
        }

            .detail-desc h6 {
                font-family: var(--font-display);
                font-size: 15px;
                letter-spacing: 1px;
                color: var(--accent);
                margin-bottom: 10px;
            }

            .detail-desc p {
                font-size: 14px;
                color: var(--text-muted);
                line-height: 1.85;
                margin: 0;
            }

        .schedule-section {
            padding: 48px 0 60px;
            background: var(--bg-void);
        }

        .section-title-cv {
            font-family: var(--font-display);
            font-size: 28px;
            letter-spacing: 2px;
            margin-bottom: 24px;
            color: var(--text-primary);
        }

            .section-title-cv span {
                color: var(--accent);
            }

        .date-strip {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            scrollbar-width: none;
            padding-bottom: 4px;
            margin-bottom: 28px;
        }

            .date-strip::-webkit-scrollbar {
                display: none;
            }

        .date-btn {
            flex-shrink: 0;
            width: 64px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 10px 0;
            text-align: center;
            cursor: pointer;
            transition: all .2s;
            text-decoration: none;
            display: block;
        }

            .date-btn.active {
                background: var(--accent);
                border-color: var(--accent);
            }

            .date-btn .day-name {
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
                text-transform: uppercase;
                color: var(--text-muted);
                display: block;
            }

            .date-btn .day-num {
                font-family: var(--font-display);
                font-size: 22px;
                color: var(--text-primary);
                line-height: 1;
                display: block;
            }

            .date-btn .month {
                font-size: 10px;
                color: var(--text-muted);
                display: block;
            }

            .date-btn.active .day-name,
            .date-btn.active .month {
                color: rgba(0,0,0,.65);
            }

            .date-btn.active .day-num {
                color: #000;
            }

        .showtime-group {
            margin-bottom: 28px;
        }

        .showtime-group-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .showtime-group-label::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border);
            }

        .showtime-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .showtime-btn {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 18px;
            cursor: pointer;
            transition: all .2s;
            text-decoration: none;
            display: block;
        }

            .showtime-btn:hover {
                border-color: rgba(232,184,75,.4);
                background: rgba(232,184,75,.06);
            }

            .showtime-btn.sold-out {
                opacity: .4;
                pointer-events: none;
            }

        .showtime-time {
            font-family: var(--font-display);
            font-size: 20px;
            letter-spacing: 1px;
            color: var(--text-primary);
            display: block;
        }

        .showtime-type {
            font-size: 10px;
            color: var(--text-muted);
            display: block;
            margin-top: 2px;
        }

        .showtime-seats {
            font-size: 10px;
            color: #4be87c;
            display: block;
            margin-top: 2px;
        }

        .showtime-btn.few-left .showtime-seats {
            color: var(--accent);
        }

        .showtime-btn.sold-out .showtime-seats {
            color: var(--red, #e84b4b);
        }

        @@media (max-width: 767px) {
            .detail-inner {
                flex-direction: column;
                align-items: center;
                gap: 28px;
            }

            .detail-poster {
                width: 180px;
            }

            .poster-img-wrap {
                width: 180px;
            }

            .poster-actions {
                flex-direction: row;
            }

            .detail-info {
                width: 100%;
            }

            .detail-title {
                font-size: 26px;
            }
        }

        /* PHAN HE DANH GIA PHIM XAC THUC */
        .reviews-section {
            padding: 60px 0 90px;
            background: #0d0f17;
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        .rating-overview-card {
            background: var(--bg-card, #181a20);
            border: 1px solid var(--border, rgba(255,255,255,0.1));
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .rating-score-box {
            text-align: center;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            margin-bottom: 20px;
        }

        .rating-score-num {
            font-size: 52px;
            font-weight: 800;
            color: #ffd700;
            line-height: 1;
            font-family: var(--font-display, sans-serif);
        }

        .rating-stars-gold {
            color: #ffd700;
            font-size: 20px;
            margin: 6px 0;
        }

        .rating-total-text {
            font-size: 13px;
            color: var(--text-muted, #8e95a5);
        }

        .star-bar-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
            font-size: 13px;
        }

        .star-bar-label {
            width: 50px;
            color: rgba(255,255,255,0.8);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .star-bar-track {
            flex: 1;
            height: 8px;
            background: rgba(255,255,255,0.08);
            border-radius: 4px;
            overflow: hidden;
        }

        .star-bar-fill {
            height: 100%;
            background: #ffd700;
            border-radius: 4px;
        }

        .star-bar-count {
            width: 35px;
            text-align: right;
            color: var(--text-muted, #8e95a5);
            font-size: 12px;
        }

        .review-form-card {
            background: var(--bg-card, #181a20);
            border: 1px solid var(--border, rgba(255,255,255,0.1));
            border-radius: 16px;
            padding: 28px;
            margin-bottom: 35px;
        }

        .interactive-stars {
            display: flex;
            gap: 8px;
            font-size: 28px;
            color: #555;
            cursor: pointer;
            margin: 10px 0 15px;
        }

        .interactive-stars .bi-star-fill.active {
            color: #ffd700;
        }

        .review-input-textarea {
            width: 100%;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 10px;
            color: #fff;
            padding: 14px 16px;
            font-size: 14px;
            resize: vertical;
            min-height: 100px;
            outline: none;
            transition: border-color 0.2s;
        }

        .review-input-textarea:focus {
            border-color: #ffd700;
        }

        .btn-submit-review {
            background: linear-gradient(135deg, #ffd700 0%, #e5a623 100%);
            color: #000;
            font-weight: 700;
            padding: 10px 24px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn-submit-review:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(229,166,35,0.3);
        }

        .review-item-card {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 14px;
            padding: 22px;
            margin-bottom: 18px;
            transition: background 0.2s;
        }

        .review-item-card:hover {
            background: rgba(255,255,255,0.04);
        }

        .review-user-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e5a623, #ff6b6b);
            color: #fff;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .verified-badge {
            background: rgba(46, 213, 115, 0.15);
            color: #2ed573;
            border: 1px solid rgba(46, 213, 115, 0.4);
            font-size: 11px;
            padding: 2px 8px;
            border-radius: 12px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
    </style>
}

@{
    string ageClass = "badge-p";
    string ageLimit = Model.GIOI_HAN_TUOI.ToUpper() ?? "";
    if (ageLimit == "T13") { ageClass = "badge-t13"; }
    else if (ageLimit == "T16") { ageClass = "badge-t16"; }
    else if (ageLimit == "T18") { ageClass = "badge-t18"; }
}


<div class="detail-backdrop">
    
    <div class="backdrop-bg">
        <img src="~/Content/HinhAnh/@Model.POSTER"
             onerror="this.src='https://placehold.co/1400x600/0a0a1a/111?text='"
             alt="" />
    </div>
    <div class="backdrop-gradient"></div>
    <div class="backdrop-gradient-bottom"></div>

    
    <div class="detail-main">
        <div class="container">
            <div class="detail-inner">

                
                <div class="detail-poster">
                    <div class="poster-img-wrap">
                        <img src="~/Content/HinhAnh/@Model.POSTER"
                             onerror="this.src='https://placehold.co/240x360/1a1a28/555?text=No+Image'"
                             alt="@Model.TEN_PHIM" />
                        <div class="poster-overlay">
                            <div class="play-icon"><i class="bi bi-play-fill"></i></div>
                        </div>
                    </div>

                    <div class="poster-actions">
                        @if (Model.TRANGTHAI == "Đang chiếu")
                        {
                            <a href="javascript:void(0)" onclick="cuonXuongLichChieu()" class="btn-book-now">
                                <i class="bi bi-ticket-perforated-fill"></i> Đặt vé ngay
                            </a>
                            <button class="btn-trailer" onclick="cuonXuongLichChieu()">
                                <i class="bi bi-calendar3"></i> Xem lịch chiếu
                            </button>
                        }
                        else if (Model.TRANGTHAI == "Sắp chiếu")
                        {
                            <div class="status-badge sap">
                                <i class="bi bi-hourglass-top"></i>
                                <span>SẮP RA MẮT</span>
                                <small>
                                    @(Model.NGAYKHOICHIEU.HasValue
                                        ? "Khởi chiếu: " + Model.NGAYKHOICHIEU.Value.ToString("dd/MM/yyyy")
                                        : "Đang cập nhật...")
                                </small>
                            </div>
                        }
                        else
                        {
                            <div class="status-badge xong">
                                <i class="bi bi-stop-circle"></i>
                                <span>ĐÃ KẾT THÚC</span>
                                <small>Cảm ơn bạn đã quan tâm</small>
                            </div>
                        }
                    </div>
                </div>

                <!-- THÔNG TIN -->
                <div class="detail-info">
                    <div class="detail-breadcrumb">
                        <a href="/">Trang chủ</a>
                        <i class="bi bi-chevron-right" style="font-size:10px"></i>
                        <a href="/Movies/DanhSachPhim">Phim</a>
                        <i class="bi bi-chevron-right" style="font-size:10px"></i>
                        <span>Chi tiết</span>
                    </div>

                    <div class="age-badge @ageClass">@Model.GIOI_HAN_TUOI</div>

                    <h1 class="detail-title">@Model.TEN_PHIM</h1>

                    <!-- Stats -->
                    <div class="detail-stats">
                        <div class="stat-item">
                            <i class="bi bi-clock"></i>
                            <span class="stat-value">@Model.THOILUONG</span>
                            <span class="stat-unit">phút</span>
                        </div>
                        <div class="stat-item">
                            <i class="bi bi-calendar3"></i>
                            <span class="stat-value">
                                @(Model.NGAYKHOICHIEU.HasValue
                                    ? Model.NGAYKHOICHIEU.Value.ToString("dd/MM/yyyy")
                                    : "Sắp cập nhật")
                            </span>
                        </div>
                        <div class="stat-item">
                            <i class="bi bi-circle-fill" style="font-size:10px; color:
                                @(Model.TRANGTHAI == "Đang chiếu" ? "#4be87c" :
                                  Model.TRANGTHAI == "Sắp chiếu"  ? "var(--accent)" : "var(--text-muted)")"></i>
                            <span class="stat-value">@Model.TRANGTHAI</span>
                        </div>
                    </div>

                    <!-- Chi tiết -->
                    <div class="detail-rows">
                        <div class="detail-row">
                            <span class="detail-label">Thể loại</span>
                            <div class="detail-value">
                                <div class="genre-tags">
                                    @foreach (var tl in Model.THELOAIs)
                                    {
                                        <span class="genre-tag">@tl.TEN_THELOAI</span>
                                    }
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.DAO_DIEN))
                        {
                            <div class="detail-row">
                                <span class="detail-label">Đạo diễn</span>
                                <span class="detail-value">@Model.DAO_DIEN</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.DIEN_VIEN))
                        {
                            <div class="detail-row">
                                <span class="detail-label">Diễn viên</span>
                                <span class="detail-value">@Model.DIEN_VIEN</span>
                            </div>
                        }
                    </div>

                    <!-- Mô tả -->
                    @if (!string.IsNullOrEmpty(Model.MOTA))
                    {
                        <div class="detail-desc">
                            <h6><i class="bi bi-card-text me-2"></i>Nội dung phim</h6>
                            <p>@Model.MOTA</p>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

<!-- LỊCH CHIẾU (chỉ hiện khi đang chiếu) -->
@if (Model.TRANGTHAI == "Đang chiếu")
{
    var lichChieus = ViewBag.LichChieu as List<DoAn_QuanLyVeXemPhimTrucTiep.Models.LICHCHIEU>;
    
    <div class="schedule-section" id="lich-chieu">
        <div class="container">
            <h2 class="section-title-cv">LỊCH <span>CHIẾU</span></h2>
            
            @if (lichChieus != null && lichChieus.Any())
            {
                var groupedByDate = lichChieus.GroupBy(l => l.NGAYCHIEU.Date).ToList();
                
                <div class="date-strip">
                    @foreach (var group in groupedByDate)
                    {
                        var isFirst = group == groupedByDate.First();
                        <button class="date-btn @(isFirst ? "active" : "")" data-target="date-@group.Key.ToString("yyyyMMdd")">
                            <span class="day-name">@group.Key.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))</span>
                            <span class="day-num">@group.Key.ToString("dd")</span>
                            <span class="month">Th @group.Key.ToString("MM")</span>
                        </button>
                    }
                </div>

                <div class="showtimes-content">
                    @foreach (var group in groupedByDate)
                    {
                        var isFirst = group == groupedByDate.First();
                        <div class="showtime-date-panel" id="date-@group.Key.ToString("yyyyMMdd")" style="display: @(isFirst ? "block" : "none")">
                            
                            @{
                                var groupedByCinema = group.GroupBy(l => l.PHONGCHIEU.RAPCHIEU).ToList();
                            }
                            
                            @foreach (var cinemaGroup in groupedByCinema)
                            {
                                <div class="showtime-group">
                                    <div class="showtime-group-label">@(cinemaGroup.Key.TEN_RAP ?? "Rạp")</div>
                                    <div class="showtime-grid">
                                        @foreach (var lc in cinemaGroup)
                                        {
                                            <a href="/Booking/ChonGhe?maLichChieu=@lc.MA_LICHCHIEU" class="showtime-btn">
                                                <span class="showtime-time">@lc.KHUNGGIO.GIOBATDAU.ToString(@"hh\:mm")</span>
                                                <span class="showtime-type">@lc.PHONGCHIEU.TEN_PHONG</span>
                                                @if(lc.GIATVE_PHUTROI > 0)
                                                {
                                                    <span class="showtime-type" style="color:var(--accent);">+@String.Format("{0:0,0}", lc.GIATVE_PHUTROI)đ</span>
                                                }
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="color: var(--text-muted)">Hiện chưa có lịch chiếu cho phim này.</p>
            }
        </div>
    </div>
}


<!-- PHAN HE DANH GIA & BINH LUAN PHIM XAC THUC -->
@{
    var danhGias = ViewBag.DanhGias as List<DoAn_QuanLyVeXemPhimTrucTiep.Models.DANHGIA> ?? new List<DoAn_QuanLyVeXemPhimTrucTiep.Models.DANHGIA>();
    int tongDanhGia = (int)(ViewBag.TongDanhGia ?? 0);
    double diemTB = (double)(ViewBag.DiemTB ?? 5.0);
    int[] starCounts = ViewBag.StarCounts as int[] ?? new int[6];
    bool daDangNhap = (bool)(ViewBag.DaDangNhap ?? false);
    bool daMuaVe = (bool)(ViewBag.DaMuaVe ?? false);
    bool daDanhGia = (bool)(ViewBag.DaDanhGia ?? false);
}

<div class="reviews-section" id="danh-gia">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h2 class="section-title-cv mb-1">DANH GIA <span>KHAN GIA</span></h2>
                <div class="text-muted small">
                    <i class="bi bi-shield-check text-success me-1"></i>Chi nguoi xem da mua ve xac thuc moi co quyen danh gia
                </div>
            </div>
            <span class="verified-badge" style="font-size: 13px; padding: 6px 14px;">
                <i class="bi bi-patch-check-fill"></i> 100% Khan gia that
            </span>
        </div>

        <div class="row g-4">
            <!-- COT TRAI: TONG QUAN XEP HANG & BIEU DO PHAN BO SAO -->
            <div class="col-lg-4">
                <div class="rating-overview-card">
                    <div class="rating-score-box">
                        <div class="rating-score-num">@diemTB.ToString("0.0")</div>
                        <div class="rating-stars-gold">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(diemTB))
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-muted"></i>
                                }
                            }
                        </div>
                        <div class="rating-total-text">Dua tren @tongDanhGia luot danh gia xac thuc</div>
                    </div>

                    <!-- Bieu do phan bo 5 den 1 sao -->
                    <div class="star-bars-container">
                        @for (int s = 5; s >= 1; s--)
                        {
                            int count = starCounts[s];
                            int pct = tongDanhGia > 0 ? (int)Math.Round((count / (double)tongDanhGia) * 100) : 0;
                            <div class="star-bar-row">
                                <div class="star-bar-label">
                                    <span>@s</span> <i class="bi bi-star-fill text-warning" style="font-size:11px;"></i>
                                </div>
                                <div class="star-bar-track">
                                    <div class="star-bar-fill" style="width: @pct%;"></div>
                                </div>
                                <div class="star-bar-count">@count</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- COT PHAI: FORM GUI DANH GIA & DANH SACH BINH LUAN -->
            <div class="col-lg-8">
                <!-- FORM DANH GIA (Theo phan quyen xac thuc) -->
                <div class="review-form-card">
                    @if (!daDangNhap)
                    {
                        <div class="text-center py-3">
                            <i class="bi bi-person-lock text-warning" style="font-size: 36px;"></i>
                            <h5 class="text-white mt-2 mb-1">Dang nhap de chia se cam nghi</h5>
                            <p class="text-muted small mb-3">Ban can dang nhap tai khoan da mua ve phim de gui danh gia xac thuc.</p>
                            <a href="/Account/DangNhap?returnUrl=@Request.RawUrl" class="btn btn-warning btn-sm fw-bold px-4">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Dang nhap ngay
                            </a>
                        </div>
                    }
                    else if (!daMuaVe)
                    {
                        <div class="p-3 rounded" style="background: rgba(229, 166, 35, 0.08); border: 1px dashed rgba(229, 166, 35, 0.3);">
                            <div class="d-flex align-items-center gap-3">
                                <div style="font-size: 32px; color: #ffd700;"><i class="bi bi-ticket-detailed"></i></div>
                                <div>
                                    <h6 class="text-warning mb-1 fw-bold">Chua co ve xem phim nay</h6>
                                    <p class="text-white-50 small mb-0">
                                        He thong CineVerse chi cho phep khan gia <strong>da mua ve va thanh toan thanh cong</strong> gui danh gia de dam bao tinh khach quan va uy tin 100%. Hay dat ve va quay lai chia se cam nghi nhe!
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                    else if (daDanhGia)
                    {
                        <div class="p-3 rounded" style="background: rgba(46, 213, 115, 0.1); border: 1px solid rgba(46, 213, 115, 0.3);">
                            <div class="d-flex align-items-center gap-3">
                                <div style="font-size: 30px; color: #2ed573;"><i class="bi bi-check-circle-fill"></i></div>
                                <div>
                                    <h6 class="text-success mb-1 fw-bold">Ban da danh gia phim nay</h6>
                                    <p class="text-white-50 small mb-0">Cam on ban da dong gop danh gia xac thuc giup cong dong nguoi xem CineVerse!</p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Khach da mua ve va chua danh gia -> Hien thi Form -->
                        using (Html.BeginForm("GuiDanhGia", "Movies", FormMethod.Post, new { id = "formGuiDanhGia" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maPhim" value="@Model.MA_PHIM" />
                            <input type="hidden" name="soSao" id="inputSoSao" value="5" />

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-white fw-bold"><i class="bi bi-chat-heart text-warning me-1"></i> Danh gia cua ban</span>
                                <span class="verified-badge"><i class="bi bi-patch-check-fill"></i> Nguoi mua ve xac thuc</span>
                            </div>

                            <div class="d-flex align-items-center gap-3 mb-2">
                                <span class="small text-muted">Chon muc hai long:</span>
                                <div class="interactive-stars" id="starPicker">
                                    <i class="bi bi-star-fill active" data-val="1"></i>
                                    <i class="bi bi-star-fill active" data-val="2"></i>
                                    <i class="bi bi-star-fill active" data-val="3"></i>
                                    <i class="bi bi-star-fill active" data-val="4"></i>
                                    <i class="bi bi-star-fill active" data-val="5"></i>
                                </div>
                                <span class="small text-warning fw-bold" id="starLabel">5/5 - Tuyet voi</span>
                            </div>

                            <div class="mb-3">
                                <textarea name="noiDung" class="review-input-textarea" rows="3" maxlength="1000" placeholder="Viet cam nhan cua ban ve noi dung, dien xuat, ky xao hoac am thanh cua bo phim..." required></textarea>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small"><i class="bi bi-info-circle me-1"></i>Danh gia cua ban se hien thi cong khai kem huy hieu xac thuc</span>
                                <button type="submit" class="btn-submit-review">
                                    <i class="bi bi-send-fill me-1"></i> Gui danh gia
                                </button>
                            </div>
                        }
                    }
                </div>

                <!-- DANH SACH BINH LUAN -->
                <div class="reviews-list">
                    @if (danhGias.Any())
                    {
                        foreach (var dg in danhGias)
                        {
                            string tenKhach = dg.KHACHHANG?.TAIKHOAN?.HOTEN ?? "Khan gia CineVerse";
                            string initial = !string.IsNullOrWhiteSpace(tenKhach) ? tenKhach.Substring(0, 1).ToUpper() : "K";
                            <div class="review-item-card">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="review-user-avatar">@initial</div>
                                        <div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="text-white fw-bold">@tenKhach</span>
                                                <span class="verified-badge"><i class="bi bi-patch-check-fill"></i> Da mua ve</span>
                                            </div>
                                            <div class="rating-stars-gold" style="font-size: 14px; margin: 2px 0;">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= dg.SOSAO)
                                                    {
                                                        <i class="bi bi-star-fill"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-star text-muted"></i>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <span class="text-muted small"><i class="bi bi-clock me-1"></i>@dg.NGAYDANHGIA.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <p class="text-white-50 mb-0 ps-5" style="font-size: 14px; line-height: 1.6;">
                                    @dg.NOIDUNG
                                </p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-chat-square-text" style="font-size: 40px; opacity: 0.4;"></i>
                            <p class="mt-3 mb-0">Chua co danh gia nao cho phim nay. Hay la nguoi dau tien xem va danh gia!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var starPicker = document.getElementById('starPicker');
        if (starPicker) {
            var stars = starPicker.querySelectorAll('.bi-star-fill');
            var inputVal = document.getElementById('inputSoSao');
            var label = document.getElementById('starLabel');
            var labels = {
                1: '1/5 - Kem',
                2: '2/5 - Tam duoc',
                3: '3/5 - Binh thuong',
                4: '4/5 - Hay',
                5: '5/5 - Tuyet voi'
            };

            stars.forEach(function (star) {
                star.addEventListener('click', function () {
                    var val = parseInt(this.getAttribute('data-val'));
                    inputVal.value = val;
                    label.textContent = labels[val] || (val + '/5');
                    stars.forEach(function (s) {
                        var sVal = parseInt(s.getAttribute('data-val'));
                        if (sVal <= val) {
                            s.classList.add('active');
                        } else {
                            s.classList.remove('active');
                        }
                    });
                });
            });
        }
        function cuonXuongLichChieu() {
            var el = document.getElementById('lich-chieu');
            if(el) {
                el.scrollIntoView({ behavior: 'smooth' });
            } else {
                alert("Phim hiện chưa có lịch chiếu.");
            }
        }

        document.querySelectorAll('.date-btn').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                
                document.querySelectorAll('.date-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                
                
                document.querySelectorAll('.showtime-date-panel').forEach(p => p.style.display = 'none');
                
                
                var targetId = this.getAttribute('data-target');
                var targetPanel = document.getElementById(targetId);
                if(targetPanel) {
                    targetPanel.style.display = 'block';
                }
            });
        });
    </script>
}
