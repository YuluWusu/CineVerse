@{
    ViewBag.Title = "Giới thiệu";
    Layout = "~/Views/Shared/_Khung.cshtml";
    ViewData["ActivePage"] = "About";
}

@section Styles {
    <style>
        /* ===== CINEMATIC ABOUT HERO BANNER (HORIZONTAL THEATER BG) ===== */
        .gt-hero {
            position: relative;
            min-height: 520px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 110px 0 95px;
            overflow: hidden;
            text-align: center;
            border-bottom: 1px solid rgba(232, 184, 75, 0.18);
            background: #090a12;
        }

        /* Horizontal Cinema Background Image Layer */
        .gt-hero-bg {
            position: absolute;
            inset: -16px;
            background-image:
                radial-gradient(ellipse 90% 70% at 50% 0%, rgba(232, 184, 75, 0.22) 0%, transparent 60%),
                radial-gradient(ellipse 60% 60% at 15% 80%, rgba(120, 58, 195, 0.24) 0%, transparent 65%),
                radial-gradient(ellipse 60% 60% at 85% 75%, rgba(28, 92, 190, 0.22) 0%, transparent 65%),
                url('/Content/HinhAnh/Backgrounds/bg-about-hero.jpg');
            background-size: cover;
            background-position: center 45%;
            background-repeat: no-repeat;
            filter: blur(3px) brightness(0.42) saturate(1.15);
            transform: scale(1.04);
            animation: heroSlowZoom 22s ease-in-out infinite alternate;
            z-index: 0;
        }

        @@keyframes heroSlowZoom {
            0% { transform: scale(1.04) translateY(0); }
            100% { transform: scale(1.11) translateY(-10px); }
        }

        /* Cinematic Vignette + Projector Light Beam Overlay */
        .gt-hero-overlay {
            position: absolute;
            inset: 0;
            background:
                linear-gradient(180deg, rgba(9, 10, 18, 0.55) 0%, rgba(11, 12, 20, 0.35) 45%, rgba(11, 12, 20, 0.96) 100%),
                radial-gradient(ellipse 65% 45% at 50% 15%, rgba(232, 184, 75, 0.14) 0%, transparent 70%);
            z-index: 1;
            pointer-events: none;
        }

        /* Subtle Film-Grain / Cinema Light Rays */
        .gt-hero-beam {
            position: absolute;
            top: -120px;
            left: 50%;
            transform: translateX(-50%);
            width: 780px;
            height: 460px;
            background: conic-gradient(from 180deg at 50% 0%, transparent 150deg, rgba(232, 184, 75, 0.12) 175deg, rgba(255, 224, 130, 0.18) 180deg, rgba(232, 184, 75, 0.12) 185deg, transparent 210deg);
            filter: blur(22px);
            z-index: 1;
            pointer-events: none;
            animation: beamPulse 6s ease-in-out infinite alternate;
        }

        @@keyframes beamPulse {
            0% { opacity: 0.55; }
            100% { opacity: 1; }
        }

        .gt-hero-content {
            position: relative;
            z-index: 2;
            max-width: 820px;
            margin: 0 auto;
        }

        .gt-hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(232, 184, 75, 0.14);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(232, 184, 75, 0.35);
            color: #f6d379;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            padding: 7px 18px;
            border-radius: 999px;
            margin-bottom: 22px;
            box-shadow: 0 0 24px rgba(232, 184, 75, 0.18);
        }

        .gt-hero-title {
            font-family: var(--font-display);
            font-size: clamp(42px, 7vw, 82px);
            font-weight: 800;
            letter-spacing: 6px;
            line-height: 1.05;
            margin-bottom: 18px;
            color: #ffffff;
            text-shadow: 0 10px 35px rgba(0, 0, 0, 0.7);
        }

        .gt-hero-title span {
            background: linear-gradient(135deg, #ffe28a 0%, #e8b84b 55%, #c98a1e 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .gt-hero-desc {
            font-size: 16.5px;
            color: rgba(240, 239, 245, 0.85);
            max-width: 650px;
            margin: 0 auto 30px;
            line-height: 1.8;
            text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
        }

        .gt-hero-pills {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
        }

        .gt-hero-pill {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 15px;
            border-radius: 999px;
            background: rgba(18, 19, 32, 0.72);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #e4e3ee;
            font-size: 12.5px;
            font-weight: 500;
            transition: all 0.25s ease;
        }

        .gt-hero-pill i {
            color: var(--accent);
        }

        .gt-hero-pill:hover {
            border-color: rgba(232, 184, 75, 0.5);
            transform: translateY(-2px);
            background: rgba(232, 184, 75, 0.12);
        }

        /* ===== FLOATING GLASS STATS BAR ===== */
        .gt-stats-wrap {
            margin-top: -54px;
            position: relative;
            z-index: 5;
            margin-bottom: 50px;
        }

        .gt-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        .gt-stat {
            background: rgba(22, 23, 38, 0.82);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid rgba(232, 184, 75, 0.2);
            border-radius: 16px;
            padding: 28px 20px;
            text-align: center;
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
            transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .gt-stat::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 20%;
            right: 20%;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
            opacity: 0.5;
            transition: opacity 0.3s ease, left 0.3s ease, right 0.3s ease;
        }

        .gt-stat:hover {
            transform: translateY(-6px);
            border-color: rgba(232, 184, 75, 0.5);
            box-shadow: 0 22px 48px rgba(0, 0, 0, 0.55), 0 0 28px rgba(232, 184, 75, 0.14);
        }

        .gt-stat:hover::after {
            opacity: 1;
            left: 8%;
            right: 8%;
        }

        .gt-stat-icon {
            font-size: 20px;
            color: var(--accent);
            margin-bottom: 10px;
            display: inline-block;
        }

        .gt-stat-num {
            font-family: var(--font-display);
            font-size: 40px;
            font-weight: 800;
            letter-spacing: 1px;
            background: linear-gradient(135deg, #fff6d6 0%, #e8b84b 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1.1;
            margin-bottom: 6px;
        }

        .gt-stat-label {
            font-size: 13px;
            font-weight: 600;
            color: #e0dfeb;
        }

        .gt-stat-sub {
            font-size: 11.5px;
            color: var(--text-muted);
            margin-top: 3px;
        }

        /* ===== SHARED SECTION STYLING ===== */
        .gt-section {
            padding: 68px 0;
            position: relative;
        }

        .gt-section-divider {
            border-top: 1px solid rgba(255, 255, 255, 0.07);
        }

        .gt-section-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: var(--accent);
            margin-bottom: 12px;
        }

        .gt-section-label::before {
            content: '';
            width: 24px;
            height: 2px;
            background: var(--accent);
            border-radius: 2px;
        }

        .gt-section-title {
            font-family: var(--font-display);
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 800;
            letter-spacing: 0.4px;
            line-height: 1.25;
            margin-bottom: 16px;
            color: #ffffff;
        }

        .gt-section-title span {
            color: var(--accent);
        }

        .gt-section-desc {
            font-size: 15px;
            color: rgba(220, 219, 232, 0.78);
            line-height: 1.85;
            max-width: 560px;
        }

        /* ===== STORY & ARCHITECTURE SECTION ===== */
        .gt-about {
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            gap: 56px;
            align-items: center;
        }

        .gt-tech-stack {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 24px;
        }

        .gt-tech-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 12px;
            font-weight: 600;
            color: #d7d6e6;
            transition: all 0.2s ease;
        }

        .gt-tech-badge i {
            color: var(--accent);
        }

        .gt-tech-badge:hover {
            border-color: rgba(232, 184, 75, 0.45);
            background: rgba(232, 184, 75, 0.1);
            color: #ffffff;
        }

        .gt-about-visual {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .gt-visual-card {
            background: rgba(24, 25, 42, 0.72);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            transition: all 0.3s ease;
        }

        .gt-visual-card:nth-child(2),
        .gt-visual-card:nth-child(4) {
            transform: translateY(14px);
        }

        .gt-visual-card:hover {
            border-color: rgba(232, 184, 75, 0.4);
            transform: translateY(-4px);
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
        }

        .gt-visual-card:nth-child(2):hover,
        .gt-visual-card:nth-child(4):hover {
            transform: translateY(8px);
        }

        .gt-visual-icon {
            width: 46px;
            height: 46px;
            background: linear-gradient(135deg, rgba(232, 184, 75, 0.22) 0%, rgba(232, 184, 75, 0.05) 100%);
            border: 1px solid rgba(232, 184, 75, 0.25);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: var(--accent);
        }

        .gt-visual-title {
            font-weight: 700;
            font-size: 15px;
            color: #ffffff;
        }

        .gt-visual-desc {
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.65;
        }

        /* ===== CINEMATIC JOURNEY TIMELINE (4 STEPS) ===== */
        .gt-journey-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-top: 42px;
            position: relative;
        }

        .gt-journey-step {
            background: rgba(22, 23, 38, 0.72);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 28px 22px;
            position: relative;
            transition: all 0.3s ease;
        }

        .gt-journey-step:hover {
            border-color: rgba(232, 184, 75, 0.45);
            transform: translateY(-5px);
            background: rgba(30, 31, 52, 0.85);
        }

        .gt-step-num {
            position: absolute;
            top: 16px;
            right: 18px;
            font-family: var(--font-display);
            font-size: 36px;
            font-weight: 800;
            color: rgba(232, 184, 75, 0.14);
            line-height: 1;
        }

        .gt-step-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: rgba(232, 184, 75, 0.12);
            border: 1px solid rgba(232, 184, 75, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: var(--accent);
            margin-bottom: 16px;
        }

        .gt-journey-step h4 {
            font-size: 16px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 8px;
        }

        .gt-journey-step p {
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.65;
            margin: 0;
        }

        /* ===== FEATURES BENTO GRID ===== */
        .gt-features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
            margin-top: 44px;
        }

        .gt-feature {
            background: rgba(24, 25, 42, 0.72);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 30px 26px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .gt-feature::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .gt-feature:hover {
            border-color: rgba(232, 184, 75, 0.38);
            transform: translateY(-6px);
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
        }

        .gt-feature:hover::before {
            opacity: 1;
        }

        .gt-feature-icon {
            width: 54px;
            height: 54px;
            background: linear-gradient(135deg, rgba(232, 184, 75, 0.18) 0%, rgba(232, 184, 75, 0.04) 100%);
            border: 1px solid rgba(232, 184, 75, 0.25);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
            color: var(--accent);
            margin-bottom: 18px;
            transition: transform 0.3s ease;
        }

        .gt-feature:hover .gt-feature-icon {
            transform: scale(1.08) rotate(-3deg);
        }

        .gt-feature h4 {
            font-size: 17px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 10px;
        }

        .gt-feature p {
            font-size: 13.5px;
            color: var(--text-muted);
            line-height: 1.75;
            margin: 0;
        }

        /* ===== TEAM SHOWCASE (4 MEMBERS - 2x2 LUXURY GRID) ===== */
        .gt-team-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 26px;
            margin-top: 44px;
        }

        .gt-member {
            background: rgba(22, 23, 38, 0.78);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.09);
            border-radius: 18px;
            padding: 30px 28px;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }

        .gt-member.leader {
            border-color: rgba(232, 184, 75, 0.32);
            background: linear-gradient(145deg, rgba(32, 27, 46, 0.85) 0%, rgba(20, 21, 35, 0.85) 100%);
        }

        .gt-member:hover {
            border-color: rgba(232, 184, 75, 0.55);
            transform: translateY(-6px);
            box-shadow: 0 22px 48px rgba(0, 0, 0, 0.5), 0 0 28px rgba(232, 184, 75, 0.1);
        }

        .gt-member-head {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
        }

        .gt-member-avatar {
            width: 88px;
            height: 88px;
            border-radius: 50%;
            padding: 3px;
            background: linear-gradient(135deg, #f6d379 0%, #c98a1e 50%, #783ac3 100%);
            flex-shrink: 0;
            position: relative;
            box-shadow: 0 8px 24px rgba(232, 184, 75, 0.22);
        }

        .gt-member-avatar-inner {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: #141526;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-size: 26px;
            font-weight: 800;
            color: var(--accent);
        }

        .gt-member-avatar-inner img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .gt-member-meta {
            flex: 1;
            min-width: 0;
        }

        .gt-member-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 3px 10px;
            border-radius: 999px;
            margin-bottom: 6px;
            background: rgba(232, 184, 75, 0.15);
            color: var(--accent);
            border: 1px solid rgba(232, 184, 75, 0.3);
        }

        .gt-member-name {
            font-size: 21px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 3px;
        }

        .gt-member-role {
            font-size: 13.5px;
            color: #b7b6cc;
            font-weight: 500;
        }

        .gt-member-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 16px;
        }

        .gt-member-tag {
            font-size: 11px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.09);
            color: #d6d5e6;
        }

        .gt-member-list {
            list-style: none;
            padding: 0;
            margin: 0 0 18px 0;
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex: 1;
        }

        .gt-member-list li {
            font-size: 13.5px;
            color: rgba(215, 214, 230, 0.82);
            line-height: 1.6;
            padding-left: 18px;
            position: relative;
        }

        .gt-member-list li::before {
            content: '▸';
            position: absolute;
            left: 0;
            top: 0;
            color: var(--accent);
            font-weight: 700;
        }

        .gt-member-progress {
            margin-top: auto;
            padding-top: 14px;
            border-top: 1px dashed rgba(255, 255, 255, 0.09);
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
            color: var(--text-muted);
        }

        .gt-member-progress strong {
            color: #4be87c;
            font-weight: 700;
        }

        /* ===== CINEMATIC CTA BANNER ===== */
        .gt-cta {
            background:
                radial-gradient(ellipse 70% 80% at 20% 20%, rgba(232, 184, 75, 0.16) 0%, transparent 60%),
                radial-gradient(ellipse 70% 80% at 80% 80%, rgba(110, 56, 190, 0.22) 0%, transparent 60%),
                linear-gradient(135deg, #161129 0%, #0e172c 100%);
            border: 1px solid rgba(232, 184, 75, 0.25);
            border-radius: 22px;
            padding: 64px 40px;
            text-align: center;
            margin: 40px 0 70px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 24px 56px rgba(0, 0, 0, 0.5);
        }

        .gt-cta h2 {
            font-family: var(--font-display);
            font-size: clamp(26px, 4vw, 40px);
            font-weight: 800;
            letter-spacing: 0.5px;
            line-height: 1.25;
            margin-bottom: 12px;
            color: #ffffff;
        }

        .gt-cta p {
            font-size: 15.5px;
            color: rgba(224, 223, 238, 0.8);
            margin-bottom: 30px;
            max-width: 560px;
            margin-left: auto;
            margin-right: auto;
        }

        .gt-cta-actions {
            display: flex;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn-cta {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: linear-gradient(135deg, #f3ca64 0%, #e8b84b 60%, #cf9825 100%);
            color: #09090f;
            font-weight: 800;
            font-size: 15px;
            letter-spacing: 0.5px;
            padding: 14px 34px;
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.25s ease;
            box-shadow: 0 8px 24px rgba(232, 184, 75, 0.3);
        }

        .btn-cta:hover {
            color: #09090f;
            transform: translateY(-3px);
            box-shadow: 0 14px 34px rgba(232, 184, 75, 0.45);
        }

        .btn-cta-outline {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.06);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.2);
            font-weight: 600;
            font-size: 15px;
            padding: 14px 28px;
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.25s ease;
        }

        .btn-cta-outline:hover {
            color: var(--accent);
            border-color: rgba(232, 184, 75, 0.5);
            background: rgba(232, 184, 75, 0.08);
            transform: translateY(-3px);
        }

        /* ===== SCROLL REVEAL ANIMATION ===== */
        .gt-reveal {
            opacity: 0;
            transform: translateY(24px);
            transition: opacity 0.65s ease, transform 0.65s ease;
        }

        .gt-reveal.is-visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 991px) {
            .gt-about {
                grid-template-columns: 1fr;
                gap: 36px;
            }

            .gt-visual-card:nth-child(2),
            .gt-visual-card:nth-child(4) {
                transform: none;
            }

            .gt-stats,
            .gt-journey-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .gt-features-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .gt-team-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 575px) {
            .gt-hero {
                min-height: 440px;
                padding: 85px 0 75px;
            }

            .gt-stats,
            .gt-journey-grid,
            .gt-features-grid,
            .gt-about-visual {
                grid-template-columns: 1fr;
            }

            .gt-member-head {
                flex-direction: column;
                text-align: center;
            }

            .gt-cta {
                padding: 40px 20px;
            }
        }
    </style>
}

<!-- ===== 1. HORIZONTAL CINEMA HERO BANNER ===== -->
<div class="gt-hero">
