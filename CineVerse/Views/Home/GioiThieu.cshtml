            <div class="gt-cta-actions">
                <a href="@Url.Action("DanhSachPhim", "Movies")" class="btn-cta">
                    <i class="bi bi-film"></i> Khám phá phim ngay
                </a>
                <a href="@Url.Action("CuaHangBapNuoc", "GioHang")" class="btn-cta-outline">
                    <i class="bi bi-cup-straw"></i> Xem Combo Bắp nước
                </a>
            </div>
        }
        else
        {
            <h2>SẴN SÀNG TRẢI NGHIỆM CINÉVERSE?</h2>
            <p>Đăng ký thành viên miễn phí ngay hôm nay để đặt vé giữ ghế tức thì, tích điểm thưởng và nhận ưu đãi hạng VIP.</p>
            <div class="gt-cta-actions">
                <a href="@Url.Action("DangKy", "Account")" class="btn-cta">
                    <i class="bi bi-person-plus-fill"></i> Đăng ký miễn phí
                </a>
                <a href="@Url.Action("DanhSachPhim", "Movies")" class="btn-cta-outline">
                    <i class="bi bi-play-circle"></i> Xem lịch phim đang chiếu
                </a>
