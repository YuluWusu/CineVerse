@{
    ViewBag.Title = "403 - Quyền truy cập bị từ chối";
    Layout = "~/Views/Shared/_Khung.cshtml";
}

<div class="container text-center py-5 my-5" style="min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center;">
    <div style="background: rgba(26,26,40,0.85); border: 1px solid rgba(232,75,75,0.3); border-radius: 16px; padding: 50px 40px; max-width: 580px; width: 100%; box-shadow: 0 20px 50px rgba(0,0,0,0.5);">
        <div style="font-family: 'Bebas Neue', sans-serif; font-size: 96px; line-height: 1; color: var(--red, #e84b4b); letter-spacing: 4px; text-shadow: 0 0 30px rgba(232,75,75,0.3);">
            403
        </div>
        <h2 style="font-family: 'Bebas Neue', sans-serif; font-size: 28px; letter-spacing: 1px; color: #fff; margin-top: 10px;">
            TRUY CẬP BỊ TỪ CHỐI
        </h2>
        <p style="color: var(--text-muted); font-size: 15px; margin: 18px 0 28px;">
            Bạn không có đặc quyền để truy cập vào tài nguyên hoặc chức năng này. Vui lòng đăng nhập bằng tài khoản có thẩm quyền thích hợp.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="/Account/DangNhap" class="btn" style="background: var(--accent); color: #000; font-weight: 700; padding: 12px 28px; border-radius: 8px;">
                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập tài khoản khác
            </a>
            <a href="/Home/TrangChu" class="btn" style="background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.15); font-weight: 500; padding: 12px 24px; border-radius: 8px;">
                <i class="bi bi-house-door-fill me-1"></i> Về Trang chủ
            </a>
        </div>
    </div>
</div>

