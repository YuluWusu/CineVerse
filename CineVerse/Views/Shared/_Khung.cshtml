<!DOCTYPE html>
<html lang="vi">
<head>
 
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CinéVerse</title>
    <link rel="shortcut icon" href="~/Content/Logo/Logo HUIT-01.ico" type="image/x-icon" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,300&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --bg-void: #09090f;
            --bg-deep: #0f0f1a;
            --bg-surface: #15151f;
            --bg-card: #1a1a28;
            --accent: #e8b84b;
            --accent-dim: #c9972a;
            --accent-glow: rgba(232,184,75,0.18);
            --red: #e84b4b;
            --text-primary: #f0eff5;
            --text-muted: #8b8a99;
            --border: rgba(255,255,255,0.07);
            --font-display: 'DM Sans', sans-serif;
            --font-body: 'DM Sans', sans-serif;
            --radius: 10px;
            --navbar-h: 70px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: var(--bg-void);
            color: var(--text-primary);
            font-family: var(--font-body);
            font-size: 15px;
            line-height: 1.6;
            overflow-x: hidden;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        img {
            max-width: 100%;
            display: block;
        }

        .cv-navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--navbar-h);
            z-index: 1000;
            background: linear-gradient(180deg, rgba(9,9,15,0.97) 0%, rgba(9,9,15,0.85) 100%);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
        }

            .cv-navbar .container-fluid {
                display: flex;
                align-items: center;
                gap: 0;
                padding: 0 32px;
            }

        .cv-logo {
            font-family: var(--font-display);
            font-size: 26px;
            letter-spacing: 3px;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

            .cv-logo span {
                color: var(--accent);
            }

        .cv-logo-dot {
            width: 8px;
            height: 8px;
            background: var(--accent);
            border-radius: 50%;
            margin-bottom: 2px;
        }

        .cv-nav-links {
            display: flex;
            align-items: center;
            gap: 4px;
            margin-left: 40px;
            list-style: none;
        }

            .cv-nav-links a {
                display: block;
                padding: 6px 14px;
                font-size: 13px;
                font-weight: 500;
                color: var(--text-muted);
                letter-spacing: 0.5px;
                border-radius: 6px;
                transition: all .2s;
            }

                .cv-nav-links a:hover, .cv-nav-links a.active {
                    color: var(--text-primary);
                    background: rgba(255,255,255,0.06);
                }

        .cv-search {
            margin-left: auto;
            position: relative;
            width: 220px;
        }

            .cv-search input {
                width: 100%;
                background: rgba(255,255,255,0.06);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 8px 14px 8px 36px;
                color: var(--text-primary);
                font-family: var(--font-body);
                font-size: 13px;
                outline: none;
                transition: border-color .2s, background .2s;
            }

                .cv-search input:focus {
                    border-color: rgba(232,184,75,.4);
                    background: rgba(255,255,255,0.09);
                }

                .cv-search input::placeholder {
                    color: var(--text-muted);
                }

            .cv-search .bi-search {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-size: 13px;
                pointer-events: none;
            }


        .cv-nav-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-left: 18px;
            flex-shrink: 0;
        }

        .btn-ghost {
            background: none;
            border: 1px solid var(--border);
            color: var(--text-primary);
            padding: 7px 16px;
            border-radius: 8px;
            font-family: var(--font-body);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all .2s;
        }

            .btn-ghost:hover {
                border-color: rgba(255,255,255,0.2);
                background: rgba(255,255,255,0.06);
            }

        .btn-gold {
            background: var(--accent);
            border: none;
            color: #09090f;
            padding: 7px 18px;
            border-radius: 8px;
            font-family: var(--font-body);
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s;
        }

            .btn-gold:hover {
                background: var(--accent-dim);
                transform: translateY(-1px);
            }


        .cv-burger {
            display: none;
            background: none;
            border: none;
            color: var(--text-primary);
            font-size: 22px;
            margin-left: auto;
            cursor: pointer;
        }


        .cv-body {
            padding-top: var(--navbar-h);
        }


        .cv-footer {
            background: var(--bg-deep);
            border-top: 1px solid var(--border);
            padding: 56px 0 28px;
            margin-top: 40px;
        }

        .cv-footer-brand {
            font-family: var(--font-display);
            font-size: 28px;
            letter-spacing: 3px;
            margin-bottom: 10px;
        }

            .cv-footer-brand span {
                color: var(--accent);
            }

        .cv-footer-tagline {
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.7;
            max-width: 260px;
        }

        .cv-footer-heading {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--accent);
            margin-bottom: 16px;
            margin-left: 30px;
        }

        .cv-footer-links {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

            .cv-footer-links a {
                font-size: 13px;
                color: var(--text-muted);
                transition: color .2s;
            }

                .cv-footer-links a:hover {
                    color: var(--text-primary);
                }

        .cv-footer-social {
            display: flex;
            gap: 10px;
            margin-top: 4px;
        }

            .cv-footer-social a {
                width: 36px;
                height: 36px;
                background: rgba(255,255,255,0.06);
                border: 1px solid var(--border);
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 15px;
                color: var(--text-muted);
                transition: all .2s;
            }

                .cv-footer-social a:hover {
                    color: var(--accent);
                    border-color: var(--accent-glow);
                }

        .cv-footer-bottom {
            border-top: 1px solid var(--border);
            margin-top: 40px;
            padding-top: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

            .cv-footer-bottom p {
                font-size: 12px;
                color: var(--text-muted);
            }

        /* ===== SHARED UTILITIES ===== */
        .section-title {
            font-family: var(--font-display);
            font-size: clamp(28px, 4vw, 38px);
            letter-spacing: 2px;
            color: var(--text-primary);
            margin-bottom: 6px;
        }

        .section-subtitle {
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 32px;
        }

        .badge-age {
            font-size: 10px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
            letter-spacing: 0.5px;
        }

        .badge-t13 {
            background: #e8b84b;
            color: #000;
        }

        .badge-t16 {
            background: #e87c4b;
            color: #fff;
        }

        .badge-t18 {
            background: #e84b4b;
            color: #fff;
        }

        .badge-p {
            background: #4be87c;
            color: #000;
        }

        @@media (max-width: 991px) {
            .cv-nav-links, .cv-search, .cv-nav-actions {
                display: none;
            }

            .cv-burger {
                display: block;
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    
    <nav class="cv-navbar">
        <div class="container-fluid">
            <a href="/" class="cv-logo">
                
                Ciné<span>Verse</span>
            </a>

            <!-- MENU 2 CẤP LẤY DỮ LIỆU ĐỘNG TỪ CSDL -->
            @Html.Action("MenuHaiCap", "Home")

            <form action="/Movies/DanhSachPhim" method="get" class="cv-search" style="margin: 0 0 0 auto;">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@Request.QueryString["search"]" placeholder="Tìm tên phim, diễn viên..." autocomplete="off" />
            </form>

            <!-- BADGE GIỎ HÀNG THỜI GIAN THỰC -->
            <div style="margin: 0 14px;">
                @Html.Action("GioHangBadge", "GioHang")
            </div>

            <div class="cv-nav-actions">
                @if (Session["KhachHang"] != null)
                {
                    var kh = Session["KhachHang"] as DoAn_QuanLyVeXemPhimTrucTiep.Models.KHACHHANG;
                    <div style="display:flex; align-items:center; gap: 15px;">
                        <span style="color: var(--accent); font-weight: 600; margin-right: 10px;">@kh.HOTEN</span>
                        @if (kh.VAITRO == "Admin")
                        {
                            <a href="/Admin/Index" class="btn-ghost" style="padding: 5px 10px; font-size: 12px;">Admin</a>
                        }
                        else
                        {
                            <a href="/Account/HoSo" class="btn-ghost" style="padding: 5px 10px; font-size: 12px;" title="Hồ sơ cá nhân"><i class="bi bi-person-circle"></i></a>
                            <a href="/Booking/LichSuVe" class="btn-ghost" style="padding: 5px 10px; font-size: 12px;" title="Lịch sử vé"><i class="bi bi-clock-history"></i></a>
                        }
                        <a href="/Account/DangXuat" class="btn-ghost" style="padding: 5px 10px; font-size: 12px;">Đăng xuất</a>
                    </div>
                }
                else if ((Session["VaiTro"] as string) == "NHANVIEN")
                {
                    <div style="display:flex; align-items:center; gap: 15px;">
                        <span style="color: var(--accent); font-weight: 600; margin-right: 10px;">@(Session["NhanVienTen"] as string)</span>
                        <a href="/NhanVien/Index" class="btn-ghost" style="padding: 5px 10px; font-size: 12px;">Quầy nhân viên</a>
                        <a href="/Account/DangXuat" class="btn-ghost" style="padding: 5px 10px; font-size: 12px;">Đăng xuất</a>
                    </div>
                }
                else
                {
                    <a href="/Account/DangNhap" class="btn-ghost">Đăng nhập</a>
                    <a href="/Account/DangKy" class="btn-gold">Đăng ký</a>
                }
            </div>

            <button class="cv-burger"><i class="bi bi-list"></i></button>
        </div>
    </nav>
    <main class="cv-body">
        @RenderBody()
    </main>

    <footer class="cv-footer">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4">
                    <div class="cv-footer-brand">Ciné<span>Verse</span></div>
                    <p class="cv-footer-tagline">Trải nghiệm điện ảnh đỉnh cao. Đặt vé nhanh, chọn ghế dễ, thưởng thức trọn vẹn.</p>
                    <div class="cv-footer-social mt-4">
                        <a href="https://www.facebook.com/philong.hoangxuan.54"><i class="bi bi-facebook"></i></a>
                        <a href="https://www.instagram.com/k.amasea/"><i class="bi bi-instagram"></i></a>
                        <a href="https://www.tiktok.com/%40bimecham"><i class="bi bi-tiktok"></i></a>
                        <a href="https://www.youtube.com/%40YuluWusu"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <p class="cv-footer-heading">Khám phá</p>
                    <ul class="cv-footer-links">
                        <li><a href="@Url.Action("DanhSachPhim", "Movies", new { trangthai = "Đang chiếu" })">Phim đang chiếu</a></li>
                        <li><a href="@Url.Action("DanhSachPhim", "Movies", new { trangthai = "Sắp chiếu" })">Phim sắp chiếu</a></li>
                        <li><a href="/Movies/LichChieuChung">Lịch chiếu</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <p class="cv-footer-heading">Tài khoản</p>
                    <ul class="cv-footer-links">
                        @if (Session["KhachHang"] != null)
                        {
                            <li><a href="/Booking/LichSuVe">Lịch sử vé</a></li>
                            <li><a href="/Account/HoSo">Hồ sơ</a></li>
                            <li><a href="/Account/DangXuat">Đăng xuất</a></li>
                        }
                        else
                        {
                            <li><a href="/Account/DangNhap">Đăng nhập</a></li>
                            <li><a href="/Account/DangKy">Đăng ký</a></li>
                        }
                    </ul>
                </div>
                <div class="col-lg-4">
                    <p class="cv-footer-heading">Liên hệ</p>
                    <ul class="cv-footer-links">
                        <li><a href="#"><i class="bi bi-envelope me-2"></i>yuluwusu@gmail.com</a></li>
                        <li><a href="#"><i class="bi bi-telephone me-2"></i>0357534303</a></li>
                        <li><a href="#"><i class="bi bi-geo-alt me-2"></i>TP. Hồ Chí Minh</a></li>
                    </ul>
                </div>
            </div>
            <div class="cv-footer-bottom">
                <p>&copy; 2026 CinéVerse. Đồ án môn Lập trình Web.</p>
                <p>Chính sách bảo mật &nbsp;·&nbsp; Điều khoản sử dụng</p>
            </div>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script>window.jQuery || document.write('<script src="/Scripts/jquery-3.7.0.min.js"><\/script>')</script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @Html.Partial("_ToastNotification")
    @RenderSection("Scripts", required: false)
</body>
</html>
