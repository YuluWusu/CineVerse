@using DoAn_QuanLyVeXemPhimTrucTiep.Models
@model DONHANG
@{
    ViewBag.Title = "Thanh toán Chuyển khoản VietQR - Đơn hàng " + Model.MA_DONHANG.Trim();
    Layout = "~/Views/Shared/_Khung.cshtml";

    string qrUrl = ViewBag.QrUrl as string ?? "";
    string bankId = ViewBag.BankId as string ?? "MB";
    string accountNo = ViewBag.AccountNo as string ?? "";
    string accountName = ViewBag.AccountName as string ?? "";
    string transferContent = ViewBag.TransferContent as string ?? "";
    long amount = (long)(ViewBag.Amount ?? (long)Model.TONGTIEN);
    int remainingSeconds = (int)(ViewBag.RemainingSeconds ?? 300);

    var danhSachGhe = Model.VEs.Select(v => v.GHE?.SOGHE?.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToList();
}

@section Styles {
<style>
    .vietqr-wrapper {
        min-height: 85vh;
        padding: 40px 0 80px;
        background: radial-gradient(circle at 50% 20%, rgba(229,166,35,0.06) 0%, rgba(10,12,18,0.95) 70%);
    }

    .vietqr-card {
        background: #141722;
        border: 1px solid rgba(229,166,35,0.25);
        border-radius: 16px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.6);
        overflow: hidden;
    }

    .vietqr-header {
        background: linear-gradient(135deg, #1b2030, #161a27);
        border-bottom: 1px solid rgba(255,255,255,0.08);
        padding: 24px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .qr-badge-live {
        background: rgba(75, 232, 124, 0.15);
        color: #4be87c;
        border: 1px solid rgba(75, 232, 124, 0.4);
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .qr-badge-live .pulse-dot {
        width: 8px;
        height: 8px;
        background: #4be87c;
        border-radius: 50%;
        animation: pulseGreen 1.4s infinite;
    }
    @@keyframes pulseGreen {
        0% { transform: scale(0.9); opacity: 0.8; }
        50% { transform: scale(1.3); opacity: 1; }
        100% { transform: scale(0.9); opacity: 0.8; }
    }

    .timer-badge {
        background: rgba(229,166,35,0.12);
        color: #e5a623;
        border: 1px solid rgba(229,166,35,0.3);
        padding: 6px 16px;
        border-radius: 24px;
        font-weight: 700;
        font-size: 15px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .timer-badge.low {
        background: rgba(232,75,75,0.15) !important;
        border-color: rgba(232,75,75,0.5) !important;
        color: #e84b4b !important;
        animation: pulseLow 1.2s infinite;
    }
    @@keyframes pulseLow {
        0%, 100% { box-shadow: 0 0 5px rgba(232,75,75,0.3); }
        50% { box-shadow: 0 0 15px rgba(232,75,75,0.6); }
    }

    .qr-container {
        background: #ffffff;
        padding: 16px;
        border-radius: 14px;
        display: inline-block;
        box-shadow: 0 8px 30px rgba(0,0,0,0.4);
        position: relative;
    }
    .qr-image {
        width: 100%;
        max-width: 280px;
        height: auto;
        display: block;
        border-radius: 8px;
    }

    .bank-info-box {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 20px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .info-row:last-child {
        border-bottom: none;
    }
    .info-label {
        color: var(--text-muted);
        font-size: 14px;
    }
    .info-value {
        color: #fff;
        font-weight: 600;
        font-size: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-copy {
        background: rgba(229,166,35,0.15);
        color: #e5a623;
        border: 1px solid rgba(229,166,35,0.3);
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-copy:hover {
        background: #e5a623;
        color: #000;
    }

    .amount-highlight {
        font-family: var(--font-display);
        color: #4be87c;
        font-size: 24px;
        font-weight: 800;
    }

    .btn-confirm-payment {
        background: linear-gradient(135deg, #e5a623, #ffc038);
        color: #000;
        font-weight: 700;
        font-size: 16px;
        padding: 14px 28px;
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 20px rgba(229,166,35,0.4);
        transition: all 0.3s;
    }
    .btn-confirm-payment:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 25px rgba(229,166,35,0.6);
        color: #000;
    }
</style>
}

<div class="vietqr-wrapper">
    <div class="container">
        <!-- Breadcrumb / Stepper -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <a href="@Url.Action("ChonMonAn", "Booking", new { maLichChieu = Model.MA_LICHCHIEU.Trim(), selectedSeats = string.Join(",", danhSachGhe) })" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
            <div class="text-muted small">
                Mã đơn hàng: <span class="text-warning fw-bold">@Model.MA_DONHANG.Trim()</span>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="vietqr-card">
                    <!-- Card Header -->
                    <div class="vietqr-header">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h4 class="text-white mb-0 fw-bold">Quét mã VietQR để thanh toán</h4>
                                <span class="qr-badge-live">
                                    <span class="pulse-dot"></span> Tự động 24/7
                                </span>
                            </div>
                            <div class="text-muted small">Hỗ trợ tất cả ứng dụng Ngân hàng (MB, Vietcombank, Techcombank, BIDV, ACB,...) và Ví điện tử</div>
                        </div>
                        <div class="timer-badge @(remainingSeconds <= 120 ? "low" : "")" id="timerBadge">
                            <i class="bi bi-clock-history"></i>
                            <span>Giữ vé: <strong id="timerDisplay">--:--</strong></span>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="p-4 p-md-5">
                        <div class="row g-4 align-items-center">
                            <!-- Cột Trái: Ảnh QR Code -->
                            <div class="col-md-5 text-center">
                                <div class="qr-container">
                                    <img src="@qrUrl" alt="VietQR Payment Code" class="qr-image" id="vietQrImg" />
                                </div>
                                <div class="mt-3 text-muted small">
                                    <i class="bi bi-qr-code-scan text-warning me-1"></i> Mở app ngân hàng, chọn <strong>Quét mã QR</strong> để thanh toán tức thì
                                </div>
                            </div>

                            <!-- Cột Phải: Thông tin chi tiết thanh toán -->
                            <div class="col-md-7">
                                <div class="bank-info-box mb-4">
                                    <div class="info-row">
                                        <span class="info-label">Ngân hàng thụ hưởng:</span>
                                        <span class="info-value">
                                            <span class="badge bg-primary">@bankId</span>
                                            <span>Ngân hàng Quân Đội (MBBank)</span>
                                        </span>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">Số tài khoản:</span>
                                        <span class="info-value">
                                            <span id="txtAccountNo" class="font-monospace text-warning fw-bold">@accountNo</span>
                                            <button type="button" class="btn-copy" onclick="copyText('txtAccountNo')">
                                                <i class="bi bi-clipboard"></i> Sao chép
                                            </button>
                                        </span>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">Tên chủ tài khoản:</span>
                                        <span class="info-value text-uppercase">@accountName</span>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">Số tiền chuyển khoản:</span>
                                        <div class="text-end">
                                            <div class="amount-highlight">@amount.ToString("#,##0") đ</div>
                                            <small class="text-muted">(Đã áp dụng mọi ưu đãi &amp; bắp nước)</small>
                                        </div>
                                    </div>
                                    <div class="info-row" style="background: rgba(229,166,35,0.08); margin: 0 -20px -20px; padding: 12px 20px; border-radius: 0 0 12px 12px;">
                                        <span class="info-label text-warning fw-semibold">Nội dung chuyển khoản (bắt buộc):</span>
                                        <span class="info-value">
                                            <span id="txtContent" class="font-monospace text-white fw-bold">@transferContent</span>
                                            <button type="button" class="btn-copy" onclick="copyText('txtContent')">
                                                <i class="bi bi-clipboard"></i> Sao chép
                                            </button>
                                        </span>
                                    </div>
                                </div>

                                <!-- Tóm tắt nhanh suất chiếu -->
                                <div class="p-3 rounded mb-4" style="background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.1); font-size: 14px;">
                                    <div class="text-white fw-bold mb-1">
                                        <i class="bi bi-film text-warning me-1"></i> @Model.LICHCHIEU.PHIM.TEN_PHIM
                                    </div>
                                    <div class="text-muted small">
                                        Rạp: <span class="text-light">@Model.LICHCHIEU.PHONGCHIEU.RAPCHIEU.TEN_RAP - @Model.LICHCHIEU.PHONGCHIEU.TEN_PHONG</span> |
                                        Suất: <span class="text-warning">@Model.LICHCHIEU.KHUNGGIO.GIOBATDAU.ToString(@"hh\:mm") (@Model.LICHCHIEU.NGAYCHIEU.ToString("dd/MM/yyyy"))</span> |
                                        Ghế: <span class="text-light fw-bold">@string.Join(", ", danhSachGhe)</span>
                                    </div>
                                </div>

                                <!-- Hành động Xác nhận / Hủy -->
                                <div class="d-flex flex-wrap gap-3 align-items-center">
                                    <button type="button" id="btnConfirmPay" class="btn btn-confirm-payment flex-grow-1" onclick="confirmVietQRPaid()">
                                        <i class="bi bi-check-circle-fill me-2"></i> Tôi đã chuyển khoản thành công
                                    </button>

                                    <form action="@Url.Action("HuyThanhToan", "Payment")" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy giao dịch và nhả ghế đang giữ?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maDonHang" value="@Model.MA_DONHANG.Trim()" />
                                        <button type="submit" class="btn btn-outline-danger">
                                            <i class="bi bi-x-circle me-1"></i> Hủy
                                        </button>
                                    </form>
                                </div>

                                <div class="text-muted small mt-3">
                                    <i class="bi bi-shield-check text-success me-1"></i> Sau khi chuyển khoản, hệ thống sẽ tự động gửi vé điện tử (E-Ticket) qua Email và lưu vào tài khoản của bạn.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Copy helper
    function copyText(elementId) {
        var text = document.getElementById(elementId).innerText;
        navigator.clipboard.writeText(text).then(function() {
            showToast("Đã sao chép vào bộ nhớ tạm: " + text, "success");
        }).catch(function() {
            var tempInput = document.createElement("input");
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand("copy");
            document.body.removeChild(tempInput);
            showToast("Đã sao chép: " + text, "success");
        });
    }

    // Countdown Timer giữ ghế
    var totalSeconds = @remainingSeconds;
    var timerDisplay = document.getElementById("timerDisplay");
    var timerBadge = document.getElementById("timerBadge");

    function updateTimer() {
        if (totalSeconds <= 0) {
            timerDisplay.innerText = "00:00";
            timerBadge.classList.add("low");
            clearInterval(timerInterval);
            alert("Đã hết thời gian giữ ghế cho đơn hàng này. Ghế đã được tự động giải phóng.");
            window.location.href = '@Url.Action("ChonGhe", "Booking", new { maLichChieu = Model.MA_LICHCHIEU.Trim() })';
            return;
        }

        var minutes = Math.floor(totalSeconds / 60);
        var seconds = totalSeconds % 60;
        timerDisplay.innerText = (minutes < 10 ? "0" : "") + minutes + ":" + (seconds < 10 ? "0" : "") + seconds;

        if (totalSeconds <= 120) {
            timerBadge.classList.add("low");
        }

        totalSeconds--;
    }

    updateTimer();
    var timerInterval = setInterval(updateTimer, 1000);

    // Xác nhận đã thanh toán VietQR
    function confirmVietQRPaid() {
        var btn = document.getElementById("btnConfirmPay");
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang xác thực chuyển khoản...';

        $.ajax({
            url: '@Url.Action("XacNhanVietQR", "Payment")',
            type: 'POST',
            data: { maDonHang: '@Model.MA_DONHANG.Trim()' },
            success: function(res) {
                if (res.success) {
                    showToast("Xác nhận chuyển khoản thành công! Đang chuyển hướng nhận vé...", "success");
                    setTimeout(function() {
                        window.location.href = res.redirectUrl;
                    }, 1200);
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i> Tôi đã chuyển khoản thành công';
                    showToast(res.message || "Xác nhận không thành công, vui lòng thử lại.", "danger");
                }
            },
            error: function() {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i> Tôi đã chuyển khoản thành công';
                showToast("Lỗi kết nối tới máy chủ. Vui lòng thử lại sau giây lát.", "danger");
            }
        });
    }

    // Toast helper
    function showToast(msg, type) {
        var alertDiv = document.createElement("div");
        alertDiv.className = "alert alert-" + (type || "info") + " alert-dismissible fade show position-fixed top-0 end-0 m-3 shadow-lg";
        alertDiv.style.zIndex = "999999";
        alertDiv.innerHTML = msg + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
        document.body.appendChild(alertDiv);
        setTimeout(function() {
            if (alertDiv.parentNode) alertDiv.parentNode.removeChild(alertDiv);
        }, 4000);
    }
</script>
}

