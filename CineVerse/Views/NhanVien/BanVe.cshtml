@model List<DoAn_QuanLyVeXemPhimTrucTiep.Models.LICHCHIEU>
@using System
@using System.Collections.Generic
@using System.Linq
@using DoAn_QuanLyVeXemPhimTrucTiep.Services
@{
    Layout = "~/Views/Shared/_NhanVienLayout.cshtml";
    var thongKeSuat = ViewBag.ThongKeSuat as Dictionary<string, ThongKeSuat>;
}

@if (TempData["Loi"] != null)
{
    <div style="background:rgba(232,75,75,.12);border:1px solid rgba(232,75,75,.4);color:var(--red);padding:12px 16px;border-radius:var(--radius);margin-bottom:16px">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Loi"]
    </div>
}
@if (ViewBag.CanhBao != null)
{
    <div style="background:rgba(232,184,75,.12);border:1px solid rgba(232,184,75,.4);color:var(--accent);padding:12px 16px;border-radius:var(--radius);margin-bottom:16px">
        <i class="bi bi-info-circle-fill"></i> @ViewBag.CanhBao
    </div>
}

<div class="adm-card">
    <div class="adm-card-header">
        <div class="adm-card-title"><i class="bi bi-cash-coin"></i> Chọn suất chiếu để bán vé</div>
    </div>
    <div class="adm-card-body" style="padding:0">
        <div style="overflow-x:auto">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th>Ngày / Giờ</th>
                        <th>Phim</th>
                        <th>Phòng</th>
                        <th>Vé đã bán</th>
                        <th style="text-align:right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:24px">Hiện không có suất chiếu nào còn bán vé được.</td></tr>
                    }
                    @foreach (var lc in Model)
                    {
                        <tr>
                            <td><strong>@StaffService.GioChieu(lc)</strong><br /><span style="font-size:11px;color:var(--text-muted)">@lc.NGAYCHIEU.ToString("dd/MM/yyyy")</span></td>
                            <td>@lc.PHIM.TEN_PHIM</td>
                            <td>@lc.PHONGCHIEU.TEN_PHONG<br /><span style="font-size:11px;color:var(--text-muted)">@lc.PHONGCHIEU.RAPCHIEU.TEN_RAP</span></td>
                            <td>@thongKeSuat[lc.MA_LICHCHIEU.Trim()].DaBan</td>
                            <td style="text-align:right">
                                <a href="/NhanVien/ChonGhe?maLichChieu=@lc.MA_LICHCHIEU.Trim()" class="btn-adm-primary">Chọn ghế <i class="bi bi-arrow-right"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
