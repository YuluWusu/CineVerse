@{
    ViewBag.Title = "Sửa Khung Giờ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model DoAn_QuanLyVeXemPhimTrucTiep.Models.KHUNGGIO

<div class="page-header mb-4">
    <h1 class="page-title">Sửa Khung Giờ: @Model.MA_KHUNGGIO</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin/QuanLyKhungGio">Khung Giờ</a></li>
            <li class="breadcrumb-item active">Sửa</li>
        </ol>
    </nav>
</div>

<div class="card" style="max-width: 500px;">
    <div class="card-body p-4">
        <form action="/Admin/SuaKhungGio/@Model.MA_KHUNGGIO" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.MA_KHUNGGIO" />
            <div class="mb-4">
                <label class="form-label">Giờ Bắt Đầu <span class="text-danger">*</span></label>
                <input type="time" name="gioBatDau" class="form-control admin-input"
                       value="@Model.GIOBATDAU.ToString(@"hh\:mm")" required />
            </div>
            <div class="mb-4">
                <label class="form-label">Giờ Kết Thúc <span class="text-danger">*</span></label>
                <input type="time" name="gioKetThuc" class="form-control admin-input"
                       value="@Model.GIOKETTHUC.ToString(@"hh\:mm")" required />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-save me-1"></i> Lưu Thay Đổi
                </button>
                <a href="/Admin/QuanLyKhungGio" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

<style>
    .card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
    }

    .page-title {
        font-family: var(--font-display);
        font-size: 28px;
        margin: 0 0 8px;
    }

    .admin-input {
        background: rgba(255,255,255,.05);
        border: 1px solid var(--border);
        color: #fff;
        padding: 10px 14px;
        border-radius: 8px;
    }

        .admin-input:focus {
            background: rgba(255,255,255,.08);
            border-color: var(--accent);
            outline: none;
            color: #fff;
        }

    .form-label {
        color: var(--text-sec);
        font-size: 14px;
        margin-bottom: 8px;
    }

    .breadcrumb-item a {
        color: var(--accent);
    }

    .breadcrumb-item.active {
        color: var(--text-muted);
    }

    .breadcrumb-item + .breadcrumb-item::before {
        color: var(--text-muted);
    }
</style>
