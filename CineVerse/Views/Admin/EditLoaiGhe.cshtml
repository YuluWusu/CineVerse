@model DoAn_QuanLyVeXemPhimTrucTiep.Models.LOAIGHE
@{
    ViewBag.Title = "Sửa Loại Ghế";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="adm-card">
            <div class="adm-card-header">
                <div class="adm-card-title">
                    <i class="bi bi-pencil-square"></i> Cập nhật loại ghế
                </div>
                <a href="@Url.Action("QuanLyLoaiGhe")" class="btn-adm-ghost" style="padding:4px 12px;">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>
            <div class="adm-card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.MA_LOAIGHE)

                    <div class="adm-form-group">
                        <label class="adm-form-label">Mã loại ghế</label>
                        <input type="text" class="adm-input" value="@Model.MA_LOAIGHE" disabled />
                    </div>

                    <div class="adm-form-group">
                        <label class="adm-form-label">Tên loại ghế <span class="req">*</span></label>
                        @Html.TextBoxFor(m => m.TEN_LOAIGHE, new { @class = "adm-input", required = "required" })
                    </div>

                    <div class="adm-form-group">
                        <label class="adm-form-label">Giá vé (VNĐ) <span class="req">*</span></label>
                        @Html.TextBoxFor(m => m.GIATVE, new { @class = "adm-input", type = "number", min = "0", step = "1000", required = "required" })
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn-adm-primary"><i class="bi bi-check-circle"></i> Cập nhật</button>
                        <a href="@Url.Action("QuanLyLoaiGhe")" class="btn-adm-ghost">Hủy bỏ</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>