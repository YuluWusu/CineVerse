@model DoAn_QuanLyVeXemPhimTrucTiep.Models.PHONGCHIEU
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="adm-card">
            <div class="adm-card-header">
                <div class="adm-card-title">
                    <i class="bi bi-plus-circle"></i> Thêm phòng chiếu mới
                </div>
            </div>
            <div class="adm-card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="adm-form-group">
                        <label class="adm-form-label">Chọn Rạp <span class="req">*</span></label>
                        <div class="adm-select-wrap">
                            @Html.DropDownList("MA_RAP", null, htmlAttributes: new { @class = "adm-select", @required="required" })
                        </div>
                    </div>

                    <div class="adm-form-group">
                        <label class="adm-form-label">Tên Phòng <span class="req">*</span></label>
                        @Html.EditorFor(model => model.TEN_PHONG, new { htmlAttributes = new { @class = "adm-input", @placeholder = "Ví dụ: Cinema 01", @required="required" } })
                    </div>
                    
                    <div style="display:flex; gap:15px; margin-bottom:20px;">
                        <div class="adm-form-group" style="flex:1;">
                            <label class="adm-form-label">Số hàng ghế <span class="req">*</span></label>
                            @Html.EditorFor(model => model.SO_HANG, new { htmlAttributes = new { @class = "adm-input", @type = "number", @min="1", @max="15", @value="10", @required="required" } })
                        </div>
                        <div class="adm-form-group" style="flex:1;">
                            <label class="adm-form-label">Số cột ghế <span class="req">*</span></label>
                            @Html.EditorFor(model => model.SO_COT, new { htmlAttributes = new { @class = "adm-input", @type = "number", @min="1", @max="20", @value="10", @required="required" } })
                        </div>
                    </div>
                    <p style="font-size:11px; color:var(--text-muted); margin-top:-10px; margin-bottom:20px;">Hệ thống sẽ tự động tạo sơ đồ ghế dạng lưới cho phòng này.</p>
                    <div style="margin-top: 30px; display:flex; gap: 10px;">
                        <button type="submit" class="btn-adm-primary"><i class="bi bi-save"></i> Lưu phòng chiếu</button>
                        <a href="/Admin/QuanLyPhong" class="btn-adm-ghost"><i class="bi bi-arrow-left"></i> Quay lại</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
