@model DoAn_QuanLyVeXemPhimTrucTiep.Models.BAPNUOC
@{
    ViewBag.Title = "Thêm mới Bắp nước & Combo";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string autoCode = ViewBag.AutoCode as string ?? "CB001";
}

<div class="adm-card" style="max-width: 800px; margin: 0 auto;">
    <div class="adm-card-header d-flex justify-content-between align-items-center">
        <div class="adm-card-title">
            <i class="bi bi-plus-circle text-warning me-2"></i> Thêm mới Bắp nước / Combo F&B
        </div>
        <a href="@Url.Action("QuanLyBapNuoc", "Admin")" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger m-3" style="background:rgba(232,75,75,.15); color:var(--red); border:1px solid var(--red); border-radius:8px; padding:12px 16px;">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        </div>
    }

    <div class="adm-card-body p-4">
        @using (Html.BeginForm("ThemBapNuoc", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label text-light fw-semibold">Mã sản phẩm <span class="text-danger">*</span></label>
                    <input type="text" name="MA_SANPHAM" class="form-control bg-dark text-white border-secondary font-monospace"
                           value="@(string.IsNullOrEmpty(Model.MA_SANPHAM) ? autoCode : Model.MA_SANPHAM)" maxlength="5" required />
                    <small class="text-muted">Tối đa 5 ký tự (VD: CB001, BP001, NU001)</small>
                </div>

                <div class="col-md-8">
                    <label class="form-label text-light fw-semibold">Tên sản phẩm / Combo <span class="text-danger">*</span></label>
                    <input type="text" name="TEN_SANPHAM" class="form-control bg-dark text-white border-secondary"
                           value="@Model.TEN_SANPHAM" placeholder="VD: Combo Couple Ngọt Ngào" required />
                </div>

                <div class="col-md-4">
                    <label class="form-label text-light fw-semibold">Phân loại <span class="text-danger">*</span></label>
                    <select name="PHANLOAI" class="form-select bg-dark text-white border-secondary">
                        <option value="Combo" @(Model.PHANLOAI == "Combo" ? "selected" : "")>Combo Ưu Đãi</option>
                        <option value="Bắp" @(Model.PHANLOAI == "Bắp" ? "selected" : "")>Bắp Rang</option>
                        <option value="Nước" @(Model.PHANLOAI == "Nước" ? "selected" : "")>Nước Uống & Trà</option>
                        <option value="Snack" @(Model.PHANLOAI == "Snack" ? "selected" : "")>Snack & Đồ Ăn Vặt</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-light fw-semibold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                    <input type="number" name="GIABAN" class="form-control bg-dark text-white border-secondary"
                           value="@Model.GIABAN" min="0" step="1000" required />
                </div>

                <div class="col-md-4">
                    <label class="form-label text-light fw-semibold">Số lượng tồn kho <span class="text-danger">*</span></label>
                    <input type="number" name="SOLUONGTON" class="form-control bg-dark text-white border-secondary"
                           value="@Model.SOLUONGTON" min="0" required />
                </div>

                <div class="col-md-12">
                    <label class="form-label text-light fw-semibold">Mô tả chi tiết combo / sản phẩm</label>
                    <textarea name="MOTA" rows="3" class="form-control bg-dark text-white border-secondary"
                              placeholder="Chi tiết thành phần combo (VD: 1 bắp phô mai lớn + 2 nước ngọt 32oz)">@Model.MOTA</textarea>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-light fw-semibold">Trạng thái kinh doanh</label>
                    <select name="TRANGTHAI" class="form-select bg-dark text-white border-secondary">
                        <option value="DangBan" @(Model.TRANGTHAI == "DangBan" ? "selected" : "")>Đang bán (Mở bán ngay)</option>
                        <option value="NgungBan" @(Model.TRANGTHAI == "NgungBan" ? "selected" : "")>Ngừng bán (Tạm ẩn)</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-light fw-semibold">Hình ảnh minh họa</label>
                    <input type="file" name="hinhAnhFile" id="fnbImageInput" class="form-control bg-dark text-white border-secondary" accept="image/*" />
                    <small class="text-muted">Định dạng hỗ trợ: JPG, PNG, WEBP</small>
                </div>

                <div class="col-12 mt-2">
                    <div id="imagePreviewContainer" style="display:none;" class="p-2 border border-secondary rounded bg-black d-inline-block">
                        <img id="imagePreview" src="#" alt="Xem trước hình ảnh" style="max-height: 140px; border-radius: 6px;" />
                    </div>
                </div>

                <div class="col-12 mt-4 pt-3 border-top border-secondary border-opacity-25 d-flex gap-2 justify-content-end">
                    <a href="@Url.Action("QuanLyBapNuoc", "Admin")" class="btn btn-secondary px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i> Lưu sản phẩm
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('fnbImageInput').addEventListener('change', function (e) {
        var file = e.target.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function (evt) {
                var preview = document.getElementById('imagePreview');
                preview.src = evt.target.result;
                document.getElementById('imagePreviewContainer').style.display = 'block';
            };
            reader.readAsDataURL(file);
        }
    });
</script>
}

