@model IEnumerable<DoAn_QuanLyVeXemPhimTrucTiep.Models.PHONGCHIEU>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="adm-card" style="margin-bottom: 20px;">
    <div class="adm-card-body" style="padding: 15px 20px;">
        <form method="get" action="/Admin/QuanLyPhong" style="display:flex; gap: 15px; align-items:flex-end;">
            <div style="flex:1; max-width: 300px;">
                <label class="adm-form-label">Bộ lọc Rạp</label>
                <div class="adm-select-wrap">
                    @Html.DropDownList("idRap", ViewBag.Raps as SelectList, "Tất cả các rạp", new { @class = "adm-select", onchange="this.form.submit()" })
                </div>
            </div>
        </form>
    </div>
</div>

<div class="adm-card">
    <div class="adm-card-header">
        <div class="adm-card-title">
            <i class="bi bi-door-open"></i> Danh sách Phòng chiếu
        </div>
        <a href="/Admin/ThemPhong" class="btn-adm-primary">
            <i class="bi bi-plus-lg"></i> Thêm phòng mới
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="margin: 20px; background: rgba(232,75,75,.15); color: var(--red); border: 1px solid var(--red);">
            @TempData["Error"]
        </div>
    }

    <div class="adm-card-body" style="padding:0">
        <div style="overflow-x:auto">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th>Mã Phòng</th>
                        <th>Thuộc Rạp</th>
                        <th>Tên Phòng</th>
                        <th>Kích thước (Hàng x Cột)</th>
                        <th style="text-align:right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span style="font-family:monospace;font-size:12px;color:var(--accent)">@item.MA_PHONG</span></td>
                            <td><strong style="color:var(--text-sec)">@item.RAPCHIEU.TEN_RAP</strong></td>
                            <td><strong>@item.TEN_PHONG</strong></td>
                            <td><span style="background:rgba(255,255,255,.06);padding:3px 8px;border-radius:4px;font-size:12px">@item.SO_HANG x @item.SO_COT</span></td>
                            <td style="text-align:right">
                                <a href="/Admin/SuaPhong/@item.MA_PHONG" class="btn-icon edit" title="Sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form action="/Admin/XoaPhong/@item.MA_PHONG" method="post" style="display:inline;" onsubmit="return confirm('Xóa phòng sẽ xóa luôn toàn bộ ghế của phòng này. Bạn có chắc chắn?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-icon del" title="Xóa">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
