@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_Khung.cshtml";
    var lichChieu = ViewBag.LichChieu as DoAn_QuanLyVeXemPhimTrucTiep.Models.LICHCHIEU;
    var selectedSeatsList = ViewBag.SelectedSeatsList as string[];
    var danhSachMon = ViewBag.DanhSachMon as List<DoAn_QuanLyVeXemPhimTrucTiep.Models.MONAN>;
}
@model List<DoAn_QuanLyVeXemPhimTrucTiep.Models.GHE>

@section Styles {
    <style>
        .checkout-container {
            padding: 50px 0 80px;
            background: var(--bg-void);
            min-height: 80vh;
        }

        .checkout-title {
            font-family: var(--font-display);
            font-size: 32px;
            margin-bottom: 30px;
            color: var(--text-primary);
            text-align: center;
        }

        .checkout-grid {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 30px;
        }

        @@media (max-width: 991px) {
            .checkout-grid {
                grid-template-columns: 1fr;
            }
        }

        .checkout-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 20px;
        }

        .card-title {
            font-size: 20px;
            color: var(--accent);
            margin-bottom: 20px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 15px;
        }

        /* Form */
        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                font-size: 14px;
                color: var(--text-muted);
            }

        .form-control {
            width: 100%;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border);
            color: #fff;
            padding: 12px 15px;
            border-radius: 8px;
            font-size: 15px;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--accent);
                background: rgba(255,255,255,0.08);
            }

        /* Tóm tắt đơn hàng */
        .summary-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            font-size: 15px;
        }

            .summary-item.movie-title {
                font-size: 18px;
                font-weight: bold;
                color: #fff;
            }

        .summary-label {
            color: var(--text-muted);
        }

        .summary-value {
            color: #fff;
            text-align: right;
        }

        .seats-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            justify-content: flex-end;
            margin-top: 5px;
        }

        .seat-badge {
            background: rgba(232,184,75,0.15);
            border: 1px solid rgba(232,184,75,0.3);
            color: var(--accent);
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 13px;
            font-weight: bold;
        }

        .divider {
            height: 1px;
            background: var(--border);
            margin: 20px 0;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .total-label {
            font-size: 18px;
            color: #fff;
        }

        .total-amount {
            font-family: var(--font-display);
            font-size: 28px;
            color: #4be87c;
        }

        .btn-submit {
            width: 100%;
            background: var(--accent);
            color: #000;
            border: none;
            padding: 15px;
            font-weight: 700;
            font-size: 16px;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 25px;
            transition: all 0.2s;
        }

            .btn-submit:hover {
                background: var(--accent-dim);
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(232,184,75,0.3);
            }

        /* Món ăn / Bắp nước */
        .food-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
        }

            .food-item:last-child {
                border-bottom: none;
            }

        .food-info {
            flex: 1;
        }

        .food-name {
            font-weight: 600;
            color: #fff;
            font-size: 15px;
        }

        .food-price {
            color: var(--accent);
            font-size: 13px;
            margin-top: 3px;
        }

        .food-qty-input {
            width: 70px;
            text-align: center;
            background: rgba(255,255,255,0.06);
            border: 1px solid var(--border);
            color: #fff;
            padding: 6px;
            border-radius: 6px;
        }

        /* Khuyến mãi */
        .promo-section {
            margin-top: 18px;
            background: rgba(232,184,75,.05);
            border: 1px dashed rgba(232,184,75,.3);
            border-radius: 10px;
            padding: 14px;
        }

        .promo-label {
            font-size: 13px;
            color: var(--accent);
            font-weight: 600;
            margin-bottom: 10px;
        }

        .promo-input-wrap {
            display: flex;
            gap: 8px;
            width: 100%;
        }

            .promo-input-wrap input {
                flex: 1;
                background: rgba(255,255,255,.06);
                border: 1px solid var(--border);
                color: #fff;
                padding: 9px 12px;
                border-radius: 7px;
                font-size: 13px;
                font-weight: 700;
                text-transform: uppercase;
            }

            .promo-input-wrap button {
                background: var(--accent);
                color: #000;
                border: none;
                padding: 9px 14px;
                border-radius: 7px;
                font-weight: 700;
                font-size: 13px;
                cursor: pointer;
            }

        .promo-msg {
            margin-top: 8px;
            font-size: 13px;
            min-height: 20px;
        }

            .promo-msg.success {
                color: #4be87c;
            }

            .promo-msg.error {
                color: #e84b4b;
            }

        .voucher-list {
            margin-top: 10px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 160px;
            overflow-y: auto;
        }

        .voucher-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(232,184,75,0.25);
            border-radius: 8px;
            padding: 8px 10px;
            cursor: pointer;
        }

        .voucher-code {
            font-weight: 700;
            color: var(--accent);
            font-size: 12px;
            background: rgba(232,184,75,0.15);
            padding: 2px 6px;
            border-radius: 4px;
        }

        .voucher-use-btn {
            background: rgba(75,232,124,0.15);
            border: 1px solid rgba(75,232,124,0.4);
            color: #4be87c;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
        }
    </style>
}

<div class="checkout-container">
    <div class="container">
        <h1 class="checkout-title">XÁC NHẬN THÔNG TIN ĐẶT VÉ</h1>

        <form action="/Booking/XuLyThanhToan" method="post" id="checkoutForm">
            <input type="hidden" name="maLichChieu" value="@lichChieu.MA_LICHCHIEU" />
            <input type="hidden" name="selectedSeats" value="@string.Join(",", selectedSeatsList)" />

            <div class="checkout-grid">

                <!-- Cột trái: Thông tin khách hàng & Bắp nước -->
                <div>
                    <div class="checkout-card">
                        <h3 class="card-title"><i class="bi bi-person-fill me-2"></i>Thông tin người đặt</h3>
                        @{
                            string hoTenVal = "";
                            string sdtVal = "";
                            string emailVal = "";
                            bool isReadonly = false;
                            if (Session["KhachHang"] != null)
                            {
                                var kh = Session["KhachHang"] as DoAn_QuanLyVeXemPhimTrucTiep.Models.KHACHHANG;
                                hoTenVal = kh.HOTEN;
                                sdtVal = kh.SDT;
                                emailVal = kh.EMAIL;
                                isReadonly = true;
                            }
                        }
                        <div class="form-group">
                            <label for="hoTen">Họ và Tên *</label>
                            <input type="text" class="form-control" id="hoTen" name="hoTen" value="@hoTenVal" required placeholder="Nhập họ và tên đầy đủ" @(isReadonly ? "readonly" : "") />
                        </div>
                        <div class="form-group">
                            <label for="soDienThoai">Số điện thoại *</label>
                            <input type="tel" class="form-control" id="soDienThoai" name="soDienThoai" value="@sdtVal" required placeholder="Nhập số điện thoại" @(isReadonly ? "readonly" : "") />
                        </div>
                        <div class="form-group">
                            <label for="Email">Email *</label>
                            <input type="text" class="form-control" id="Email" name="Email" value="@emailVal" required placeholder="Nhập Email" @(isReadonly ? "readonly" : "") />
                        </div>
                    </div>

                    <!-- Khối chọn Bắp Nước -->
                    @if (danhSachMon != null && danhSachMon.Any())
                    {
                        <div class="checkout-card">
                            <h3 class="card-title"><i class="bi bi-cup-straw me-2"></i>Chọn Bắp Nước & Đồ Ăn Kèm</h3>
                            <div class="food-list">
                                @foreach (var mon in danhSachMon)
                                {
                                    <div class="food-item">
                                        <div class="food-info">
                                            <div class="food-name">@mon.TEN_MON</div>
                                            <div class="food-price">@String.Format("{0:0,0}", mon.GIA)đ</div>
                                        </div>
                                        <input type="number" min="0" max="10" value="0"
                                               class="food-qty-input food-qty"
                                               name="mon_@mon.MA_MON.Trim()"
                                               data-price="@mon.GIA"
                                               onchange="tinhTien()" onkeyup="tinhTien()" />
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Cột phải: Tóm tắt đơn hàng & Thanh toán -->
                <div>
                    <div class="checkout-card">
                        <h3 class="card-title">Tóm tắt đơn hàng</h3>

                        <div class="summary-item movie-title">
                            <span>@lichChieu.PHIM.TEN_PHIM</span>
                        </div>

                        <div class="summary-item">
                            <span class="summary-label">Rạp:</span>
                            <span class="summary-value">@lichChieu.PHONGCHIEU.RAPCHIEU.TEN_RAP - @lichChieu.PHONGCHIEU.TEN_PHONG</span>
                        </div>

                        <div class="summary-item">
                            <span class="summary-label">Suất chiếu:</span>
                            <span class="summary-value">@lichChieu.KHUNGGIO.GIOBATDAU.ToString(@"hh\:mm") | @lichChieu.NGAYCHIEU.ToString("dd/MM/yyyy")</span>
                        </div>

                        <div class="divider"></div>

                        <div class="summary-item">
                            <span class="summary-label">Ghế chọn (@Model.Count vé):</span>
                            <div class="summary-value">
                                <div class="seats-list">
                                    @foreach (var ghe in Model)
                                    {
                                        <span class="seat-badge">@ghe.SOGHE</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @{
                            decimal tongPhuThu = (lichChieu.GIATVE_PHUTROI ?? 0) * Model.Count;
                            decimal tongGiaGhe = Model.Sum(g => g.LOAIGHE.GIATVE);
                            decimal tongTienVe = tongGiaGhe + tongPhuThu;
                        }

                        <input type="hidden" id="hdTongTienVe" value="@tongTienVe" />

                        <!-- Dòng hiển thị tiền bắp nước -->
                        <div id="foodRow" class="summary-item" style="display:none;">
                            <span class="summary-label">Bắp nước:</span>
                            <span class="summary-value" id="foodAmt">0đ</span>
                        </div>

                        <div class="divider"></div>

                        <div class="total-row">
                            <span class="total-label">Tổng thanh toán:</span>
                            <span class="total-amount" id="totalDisplay">@String.Format("{0:0,0}", tongTienVe)đ</span>
                        </div>

                        <!-- Khuyến mãi -->
                        <div class="promo-section">
                            <div class="promo-label"><i class="bi bi-tag-fill me-1"></i> Mã Khuyến Mãi</div>
                            <div class="promo-input-wrap">
                                <input type="text" id="promoCodeInput" placeholder="Nhập mã..." style="text-transform:uppercase;" maxlength="20" />
                                <button type="button" id="btnApplyPromo" onclick="applyPromo()">Áp dụng</button>
                            </div>
                            <div id="promoMsg" class="promo-msg"></div>

                            @{
                                var dsKhuyenMai = ViewBag.DanhSachKM as List<DoAn_QuanLyVeXemPhimTrucTiep.Models.KHUYENMAI>;
                            }
                            @if (dsKhuyenMai != null && dsKhuyenMai.Any())
                            {
                                <div class="voucher-list">
                                    @foreach (var km in dsKhuyenMai)
                                    {
                                        <div class="voucher-item" onclick="selectPromo('@km.MA_CODE')">
                                            <div>
                                                <span class="voucher-code">@km.MA_CODE</span>
                                                <span style="font-size:12px; color:#fff; margin-left:4px;">@km.TEN_KM</span>
                                            </div>
                                            <span class="voucher-use-btn">Dùng ngay</span>
                                        </div>
                                    }
                                </div>
                            }

                            <input type="hidden" name="maCodeKhuyenMai" id="hdMaCode" value="" />
                            <input type="hidden" name="maKmId" id="hdMaKmId" value="" />
                        </div>

                        <div id="discountRow" class="summary-item" style="display:none; margin-top:15px;">
                            <span class="summary-label" style="color:#4be87c;"><i class="bi bi-gift me-1"></i>Khuyến mãi:</span>
                            <span class="summary-value" style="color:#4be87c;" id="discountAmt">-0đ</span>
                        </div>

                        <div id="finalTotalWrap" style="display:none;">
                            <div class="divider"></div>
                            <div class="total-row">
                                <span class="total-label">Thực thanh toán:</span>
                                <span class="total-amount" id="finalDisplay" style="color:#4be87c;"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn-submit">THANH TOÁN NGAY</button>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

<script>
    function formatMoney(n) {
        return n.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ',') + 'đ';
    }

    // Tính tổng tiền động gồm (Tiền vé + Tiền bắp nước)
    function tinhTien() {
        var tongTienVe = parseFloat(document.getElementById('hdTongTienVe').value);
        var tongTienFood = 0;

        var foodInputs = document.querySelectorAll('.food-qty');
        foodInputs.forEach(function (inp) {
            var qty = parseInt(inp.value) || 0;
            var price = parseFloat(inp.getAttribute('data-price')) || 0;
            if (qty > 0) {
                tongTienFood += qty * price;
            }
        });

        // Hiển thị tiền bắp nước nếu > 0
        var foodRow = document.getElementById('foodRow');
        var foodAmt = document.getElementById('foodAmt');
        if (tongTienFood > 0) {
            foodRow.style.display = 'flex';
            foodAmt.textContent = formatMoney(tongTienFood);
        } else {
            foodRow.style.display = 'none';
        }

        var tongCong = tongTienVe + tongTienFood;
        document.getElementById('totalDisplay').textContent = formatMoney(tongCong);

        // Nếu đang áp dụng mã giảm giá, cần tính lại mã giảm giá theo tổng tiền mới
        var appliedCode = document.getElementById('hdMaCode').value;
        if (appliedCode) {
            applyPromo(); // Tự động check lại mã giảm giá với tổng tiền mới
        }
    }

    function selectPromo(code) {
        document.getElementById('promoCodeInput').value = code;
        applyPromo();
    }

    function applyPromo() {
        var code = document.getElementById('promoCodeInput').value.trim().toUpperCase();

        // Tính lại tổng gốc (Vé + Bắp nước)
        var tongTienVe = parseFloat(document.getElementById('hdTongTienVe').value);
        var tongTienFood = 0;
        document.querySelectorAll('.food-qty').forEach(function (inp) {
            var qty = parseInt(inp.value) || 0;
            var price = parseFloat(inp.getAttribute('data-price')) || 0;
            if (qty > 0) { tongTienFood += qty * price; }
        });
        var tongGoc = tongTienVe + tongTienFood;

        var msg = document.getElementById('promoMsg');
        var btn = document.getElementById('btnApplyPromo');

        if (!code) {
            msg.className = 'promo-msg error';
            msg.textContent = 'Vui lòng nhập mã khuyến mãi.';
            return;
        }

        btn.disabled = true;
        msg.className = 'promo-msg';
        msg.textContent = 'Đang kiểm tra...';

        fetch('/Admin/KiemTraKhuyenMai', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'maCode=' + encodeURIComponent(code) + '&tongTien=' + tongGoc
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                btn.disabled = false;
                if (data.success) {
                    msg.className = 'promo-msg success';
                    msg.textContent = data.message;

                    document.getElementById('hdMaCode').value = code;
                    document.getElementById('hdMaKmId').value = data.maKm;

                    document.getElementById('discountRow').style.display = 'flex';
                    document.getElementById('discountAmt').textContent = '-' + formatMoney(data.soTienGiam);
                    document.getElementById('finalTotalWrap').style.display = 'block';
                    document.getElementById('finalDisplay').textContent = formatMoney(data.tongSauGiam);
                    document.getElementById('btnApplyPromo').textContent = 'Đã áp dụng ✓';
                    document.getElementById('btnApplyPromo').style.background = '#4be87c';
                } else {
                    msg.className = 'promo-msg error';
                    msg.textContent = data.message;
                    clearPromo();
                }
            })
            .catch(function () {
                btn.disabled = false;
                msg.className = 'promo-msg error';
                msg.textContent = 'Có lỗi xảy ra.';
            });
    }

    function clearPromo() {
        document.getElementById('hdMaCode').value = '';
        document.getElementById('hdMaKmId').value = '';
        document.getElementById('discountRow').style.display = 'none';
        document.getElementById('finalTotalWrap').style.display = 'none';
    }

    document.getElementById('promoCodeInput').addEventListener('input', function () {
        if (this.value === '') {
            clearPromo();
            document.getElementById('promoMsg').textContent = '';
            document.getElementById('btnApplyPromo').textContent = 'Áp dụng';
            document.getElementById('btnApplyPromo').style.background = '';
        }
    });

    document.getElementById('promoCodeInput').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); applyPromo(); }
    });
</script>