@model List<DoAn_QuanLyVeXemPhimTrucTiep.Models.GHE>
@using System
@using System.Collections.Generic
@using System.Linq
@using DoAn_QuanLyVeXemPhimTrucTiep.Services
@using DoAn_QuanLyVeXemPhimTrucTiep.Models
@{
    ViewBag.Title = "Chọn ghế và bắp nước";
    Layout = "~/Views/Shared/_Khung.cshtml"; // Dùng chung layout trang chủ của khách
    var lichChieu = ViewBag.LichChieu as LICHCHIEU;
    var gheDaDat = ViewBag.GheDaDat as List<string>;
    var danhSachMon = ViewBag.DanhSachMon as List<MONAN>;
    decimal phuTroi = lichChieu.GIATVE_PHUTROI ?? 0;
    var cacHang = Model.GroupBy(g => g.SO_HANG).OrderBy(h => h.Key).ToList();
}

@section Styles {
    <style>
        .checkout-container {
            padding: 40px 0 80px;
            background: var(--bg-void);
            min-height: 80vh;
        }

        .seat-wrap {
            overflow-x: auto;
            padding: 10px 0 20px;
        }

        .screen-bar {
            height: 6px;
            border-radius: 6px;
            background: var(--accent);
            opacity: .7;
            margin: 0 auto 26px;
            max-width: 520px;
            box-shadow: 0 8px 30px var(--accent-glow);
        }

        .screen-label {
            text-align: center;
            font-size: 11px;
            letter-spacing: 3px;
            color: var(--text-muted);
            margin-bottom: 18px;
        }

        .seat-row {
            display: flex;
            justify-content: center;
            gap: 6px;
            margin-bottom: 6px;
        }

        .seat {
            min-width: 38px;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--bg-hover);
            color: var(--text-sec);
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }

            .seat.vip {
                border-color: rgba(232,184,75,.5);
            }

            .seat.doi {
                min-width: 62px;
                border-color: rgba(75,139,232,.5);
            }

            .seat.taken {
                background: rgba(232,75,75,.15);
                color: var(--text-muted);
                cursor: not-allowed;
                text-decoration: line-through;
            }

            .seat.chon {
                background: var(--accent);
                color: #111;
                border-color: var(--accent);
            }

        .legend {
            display: flex;
            gap: 18px;
            justify-content: center;
            font-size: 12px;
            color: var(--text-sec);
            flex-wrap: wrap;
        }

            .legend i {
                display: inline-block;
                width: 14px;
                height: 14px;
                border-radius: 4px;
                vertical-align: -2px;
                margin-right: 6px;
                border: 1px solid var(--border);
                background: var(--bg-hover);
            }

        .mon-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
        }

            .mon-row input {
                width: 80px;
            }

        .tong-tien {
            font-size: 26px;
            font-weight: 700;
            color: var(--accent);
        }

        .adm-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 24px;
        }

        .adm-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            background: rgba(255,255,255,.02);
        }

        .adm-card-title {
            font-size: 16px;
            color: var(--text-pri);
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: bold;
        }

        .adm-card-body {
            padding: 20px;
        }

        .adm-input {
            background: rgba(255,255,255,.04);
            border: 1px solid var(--border);
            border-radius: 9px;
            padding: 10px 14px;
            color: #fff;
        }

        .btn-adm-primary {
            background: var(--accent);
            color: #000;
            font-weight: 700;
            padding: 10px 24px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            text-decoration: none;
        }

        .btn-adm-ghost {
            background: rgba(255,255,255,.05);
            color: var(--text-sec);
            padding: 10px 16px;
            border-radius: 8px;
            border: 1px solid var(--border);
            text-decoration: none;
        }
    </style>
}

<div class="checkout-container">
    <div class="container" style="max-width: 900px;">
        <h2 style="font-family:'Bebas Neue'; letter-spacing:2px; margin-bottom: 24px; color: var(--accent); text-align:center;">ĐẶT VÉ & CHỌN BẮP NƯỚC</h2>

        @if (TempData["Loi"] != null)
        {
            <div style="background:rgba(232,75,75,.12);border:1px solid rgba(232,75,75,.4);color:var(--red);padding:12px 16px;border-radius:8px;margin-bottom:16px">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Loi"]
            </div>
        }

        <div class="adm-card" style="margin-bottom:20px">
            <div class="adm-card-body" style="padding:15px 20px">
                <strong style="font-size:18px; color:#fff;">@lichChieu.PHIM.TEN_PHIM</strong><br />
                <span style="color:var(--text-sec)">
                    @lichChieu.PHONGCHIEU.TEN_PHONG · @lichChieu.PHONGCHIEU.RAPCHIEU.TEN_RAP · @lichChieu.NGAYCHIEU.ToString("dd/MM/yyyy") · @lichChieu.KHUNGGIO.GIOBATDAU.ToString(@"hh\:mm")
                </span>
            </div>
        </div>

        <!-- Chuyển action sang phương thức POST để gọi đến Action ThanhToan trong BookingController -->
        <form method="post" action="/Booking/ThanhToan">
            @Html.AntiForgeryToken()
            <input type="hidden" name="maLichChieu" value="@lichChieu.MA_LICHCHIEU.Trim()" />
            <input type="hidden" name="selectedSeats" id="selectedSeats" value="" />

            <div class="adm-card" style="margin-bottom:20px">
                <div class="adm-card-header">
                    <div class="adm-card-title"><i class="bi bi-grid-3x3-gap-fill"></i> Sơ đồ ghế ngồi</div>
                </div>
                <div class="adm-card-body">
                    <div class="screen-label">MÀN HÌNH</div>
                    <div class="screen-bar"></div>
                    <div class="seat-wrap">
                        @foreach (var hang in cacHang)
                        {
                            <div class="seat-row">
                                @foreach (var ghe in hang.OrderBy(g => g.SO_COT))
                                {
                                    string maGhe = ghe.MA_GHE.Trim();
                                    bool daDat = gheDaDat.Contains(maGhe);
                                    string tenLoai = ghe.LOAIGHE.TEN_LOAIGHE.Trim();
                                    string lop = "seat" + (tenLoai == "VIP" ? " vip" : (tenLoai == "Đôi" ? " doi" : "")) + (daDat ? " taken" : "");
                                    string gia = (ghe.LOAIGHE.GIATVE + phuTroi).ToString("0");
                                    string tieuDeGhe = tenLoai + " - " + String.Format("{0:0,0}", ghe.LOAIGHE.GIATVE + phuTroi) + "đ";
                                    <button type="button" class="@lop" data-ma="@maGhe" data-gia="@gia" @(daDat ? "disabled" : "") title="@tieuDeGhe">@ghe.SOGHE</button>
                                }
                            </div>
                        }
                    </div>
                    <div class="legend" style="margin-top: 15px;">
                        <span><i></i>Ghế thường</span>
                        <span><i style="border-color:rgba(232,184,75,.7)"></i>VIP</span>
                        <span><i style="border-color:rgba(75,139,232,.7)"></i>Ghế đôi</span>
                        <span><i style="background:var(--accent)"></i>Đang chọn</span>
                        <span><i style="background:rgba(232,75,75,.3)"></i>Đã có người đặt</span>
                    </div>
                </div>
            </div>

            @if (danhSachMon != null && danhSachMon.Count > 0)
            {
                <div class="adm-card" style="margin-bottom:20px">
                    <div class="adm-card-header">
                        <div class="adm-card-title"><i class="bi bi-cup-straw"></i> Chọn Bắp Nước & Đồ Ăn Kèm (Tùy chọn)</div>
                    </div>
                    <div class="adm-card-body">
                        @foreach (var mon in danhSachMon)
                        {
                            <div class="mon-row">
                                <div>
                                    <strong style="color:#fff;">@mon.TEN_MON</strong><br />
                                    <span style="font-size:12px;color:var(--accent)">@String.Format("{0:0,0}", mon.GIA)đ</span>
                                </div>
                                <input type="number" min="0" max="10" value="0" class="adm-input mon-sl" name="mon_@mon.MA_MON.Trim()" data-gia="@mon.GIA.ToString("0")" />
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="adm-card">
                <div class="adm-card-body" style="display:flex;gap:20px;flex-wrap:wrap;align-items:center;justify-content:space-between">
                    <div>
                        <div style="font-size:12px;color:var(--text-muted)">Tổng tạm tính</div>
                        <div class="tong-tien" id="tongTien">0đ</div>
                        <div style="font-size:13px;color:var(--text-sec);margin-top:4px" id="gheDangChon">Chưa chọn ghế</div>
                    </div>
                    <div>
                        <a href="/Movies/ChiTietPhim/@lichChieu.MA_PHIM.Trim()" class="btn-adm-ghost" style="margin-right: 10px;">Quay lại</a>
                        <button type="submit" class="btn-adm-primary" id="nutThanhToan" disabled><i class="bi bi-arrow-right"></i> Tiếp tục thanh toán</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var daChon = [];
            var hidden = document.getElementById('selectedSeats');
            var nut = document.getElementById('nutThanhToan');

            function dinhDang(so) {
                return so.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',') + 'đ';
            }

            function capNhat() {
                var tong = 0;
                document.querySelectorAll('.seat.chon').forEach(function (s) { tong += parseInt(s.getAttribute('data-gia'), 10); });
                document.querySelectorAll('.mon-sl').forEach(function (o) {
                    var sl = parseInt(o.value, 10);
                    if (!isNaN(sl) && sl > 0) tong += sl * parseInt(o.getAttribute('data-gia'), 10);
                });
                hidden.value = daChon.join(',');
                document.getElementById('tongTien').textContent = dinhDang(tong);
                document.getElementById('gheDangChon').textContent = daChon.length ? ('Ghế đã chọn: ' + daChon.join(', ')) : 'Chưa chọn ghế';
                nut.disabled = daChon.length === 0;
            }

            document.querySelectorAll('.seat').forEach(function (s) {
                s.addEventListener('click', function () {
                    if (s.classList.contains('taken')) return;
                    var ma = s.getAttribute('data-ma');
                    var vt = daChon.indexOf(ma);
                    if (vt >= 0) { daChon.splice(vt, 1); s.classList.remove('chon'); }
                    else { daChon.push(ma); s.classList.add('chon'); }
                    capNhat();
                });
            });

            document.querySelectorAll('.mon-sl').forEach(function (o) { o.addEventListener('input', capNhat); });
            capNhat();
        })();
    </script>
}