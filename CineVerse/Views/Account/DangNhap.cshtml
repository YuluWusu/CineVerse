@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Khung.cshtml";
}

@section Styles {
    <style>
        .auth-container {
            padding: 80px 0;
            background: var(--bg-void);
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .auth-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 40px;
            width: 100%;
            max-width: 450px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        }

        .auth-title {
            font-family: var(--font-display);
            font-size: 32px;
            color: var(--text-primary);
            text-align: center;
            margin-bottom: 30px;
            letter-spacing: 1px;
        }

            .auth-title span {
                color: var(--accent);
            }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                color: var(--text-muted);
                font-size: 14px;
            }

        .form-control {
            width: 100%;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border);
            color: #fff;
            padding: 12px 15px;
            border-radius: 8px;
            font-size: 15px;
            transition: all 0.2s;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--accent);
                background: rgba(255,255,255,0.08);
            }

        .btn-auth {
            width: 100%;
            background: var(--accent);
            color: #000;
            border: none;
            padding: 14px;
            font-weight: 700;
            font-size: 16px;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 10px;
            transition: all 0.2s;
        }

            .btn-auth:hover {
                background: var(--accent-dim);
                transform: translateY(-2px);
            }

        .auth-links {
            text-align: center;
            margin-top: 25px;
            font-size: 14px;
            color: var(--text-muted);
        }

            .auth-links a {
                color: var(--accent);
                text-decoration: none;
                font-weight: 500;
            }

                .auth-links a:hover {
                    text-decoration: underline;
                }

        .alert-error {
            background: rgba(232, 75, 75, 0.1);
            border: 1px solid rgba(232, 75, 75, 0.3);
            color: #e84b4b;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .quick-login-divider {
            position: relative;
            text-align: center;
            margin: 25px 0 16px;
        }

            .quick-login-divider::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 0;
                right: 0;
                height: 1px;
                background: var(--border, rgba(255, 255, 255, 0.1));
            }

            .quick-login-divider span {
                position: relative;
                background: var(--bg-card, #1a1a24);
                padding: 0 12px;
                font-size: 12px;
                color: var(--text-muted, #888);
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

        .quick-login-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .quick-login-row {
            display: flex;
            align-items: center;
            width: 100%;
            padding: 10px 14px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border, rgba(255, 255, 255, 0.1));
            border-radius: 8px;
            color: #fff;
            cursor: pointer;
            text-align: left;
            transition: all 0.2s ease;
        }

            .quick-login-row:hover {
                transform: translateY(-1px);
            }

            .quick-login-row.admin:hover {
                border-color: #e5a623;
                background: rgba(229, 166, 35, 0.08);
            }

            .quick-login-row.user:hover {
                border-color: #3b82f6;
                background: rgba(59, 130, 246, 0.08);
            }

        .quick-login-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-right: 12px;
        }

            .quick-login-badge.admin {
                background: rgba(229, 166, 35, 0.15);
                color: #e5a623;
                border: 1px solid rgba(229, 166, 35, 0.3);
            }

            .quick-login-badge.user {
                background: rgba(59, 130, 246, 0.15);
                color: #60a5fa;
                border: 1px solid rgba(59, 130, 246, 0.3);
            }

        .quick-login-text {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .quick-login-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary, #fff);
        }

        .quick-login-phone {
            font-size: 12px;
            color: var(--text-muted, #888);
            font-family: monospace;
        }

        .quick-login-arrow {
            font-size: 18px;
            color: var(--text-muted, #888);
            transition: transform 0.2s, color 0.2s;
        }

        .quick-login-row:hover .quick-login-arrow {
            color: var(--accent, #e5a623);
            transform: translateX(3px);
        }
    </style>
}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-title">ĐĂNG <span>NHẬP</span></h1>

        @if (ViewBag.Error != null)
        {
            <div class="alert-error">
                <i class="bi bi-exclamation-circle me-2"></i> @ViewBag.Error
            </div>
        }

        <form action="/Account/DangNhap" method="post" id="loginForm">
            @Html.AntiForgeryToken()
            @if (!string.IsNullOrEmpty(ViewBag.ReturnUrl as string))
            {
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            }
            <div class="form-group">
                <label for="SDT">Số điện thoại</label>
                <input style="color:white" type="tel" id="SDT" name="SDT" class="form-control" placeholder="Nhập số điện thoại" required />
            </div>

            <div class="form-group">
                <label for="MATKHAU">Mật khẩu</label>
                <input style="color:white" type="password" id="MATKHAU" name="MATKHAU" class="form-control" placeholder="Nhập mật khẩu" required />
            </div>

            <button type="submit" class="btn-auth">ĐĂNG NHẬP</button>
        </form>

        <div class="quick-login-divider">
            <span>Hoặc đăng nhập nhanh</span>
        </div>

        <div class="quick-login-group">
            <!-- Dòng 1: Quản trị viên (Admin) -->
            <button type="button" class="quick-login-row admin" onclick="quickLogin('0999999999', 'hash_admin_pw')" title="Đăng nhập nhanh với quyền Admin">
                <div class="quick-login-badge admin">
                    <i class="bi bi-shield-lock-fill"></i> Admin
                </div>
                <div class="quick-login-text">
                    <span class="quick-login-name">Quản Trị Viên</span>
                    <span class="quick-login-phone">0999999999</span>
                </div>
                <i class="bi bi-box-arrow-in-right quick-login-arrow"></i>
            </button>

            <!-- Dòng 2: Khách hàng (User) -->
            <button type="button" class="quick-login-row user" onclick="quickLogin('0901234567', 'hash_matkhau_1')" title="Đăng nhập nhanh với quyền Khách hàng">
                <div class="quick-login-badge user">
                    <i class="bi bi-person-fill"></i> User
                </div>
                <div class="quick-login-text">
                    <span class="quick-login-name">Nguyễn Văn An</span>
                    <span class="quick-login-phone">0901234567</span>
                </div>
                <i class="bi bi-box-arrow-in-right quick-login-arrow"></i>
            </button>
        </div>

        <div class="auth-links">
            Chưa có tài khoản? <a href="/Account/DangKy">Đăng ký ngay</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function quickLogin(sdt, matKhau) {
            var sdtInput = document.getElementById('SDT');
            var mkInput = document.getElementById('MATKHAU');
            if (sdtInput && mkInput) {
                sdtInput.value = sdt;
                mkInput.value = matKhau;
                var form = document.getElementById('loginForm') || sdtInput.closest('form');
                if (form) {
                    form.submit();
                }
            }
        }
    </script>
}
