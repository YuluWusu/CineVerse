
@{
    ViewBag.Title = "DatLaiMatKhau";
    Layout = "~/Views/Shared/_Khung.cshtml";
}

<div class="container" style="max-width: 480px; margin: 70px auto;">
    <div class="card shadow p-4">
        <h3 class="text-center mb-3">Đặt lại mật khẩu</h3>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }

        @if (ViewBag.Token != null)
        {
            <p class="text-center text-muted">
                Vui lòng nhập mật khẩu mới của bạn.
            </p>

            using (Html.BeginForm("DatLaiMatKhau", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="token"
                       value="@ViewBag.Token" />

                <div class="form-group mb-3">
                    <label for="matKhauMoi">Mật khẩu mới</label>
                    <input type="password"
                           id="matKhauMoi"
                           name="matKhauMoi"
                           class="form-control"
                           placeholder="Nhập mật khẩu mới"
                           minlength="6"
                           required />
                </div>

                <div class="form-group mb-3">
                    <label for="xacNhanMatKhau">Xác nhận mật khẩu</label>
                    <input type="password"
                           id="xacNhanMatKhau"
                           name="xacNhanMatKhau"
                           class="form-control"
                           placeholder="Nhập lại mật khẩu mới"
                           minlength="6"
                           required />

                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Xác nhận đổi mật khẩu
                </button>
            }
        }
        else
        {
            <div class="text-center">
                <p>Link đặt lại mật khẩu không còn hợp lệ.</p>

                <a href="@Url.Action("QuenMatKhau", "Account")"
                   class="btn btn-primary">
                    Yêu cầu link mới
                </a>
            </div>
        }

        <div class="text-center mt-3">
            <a href="@Url.Action("DangNhap", "Account")">
                Quay lại đăng nhập
            </a>
        </div>
    </div>
</div>